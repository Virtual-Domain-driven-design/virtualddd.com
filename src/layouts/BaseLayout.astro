---
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import logo from '../assets/logo-virtualddd.png';
import Socials from '../components/Socials.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/sessions/', label: 'Online sessions' },
  { href: '/facilitating-archdes/', label: 'Facilitating Stories' },
  { href: '/open-space/', label: 'Open Space' },
  { href: '/heuristics/', label: 'Heuristics' },
  { href: '/ddd-crew/', label: 'ddd crew' },
  { href: '/about-us/', label: 'About us' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

// Latest sessions for the footer.
const latest = (await getCollection('sessions'))
  .sort((a, b) => +new Date(b.data.datetime) - +new Date(a.data.datetime))
  .slice(0, 3);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="topbar">
        <div class="wrap topbar-inner"><Socials /></div>
      </div>
      <div class="wrap header-inner">
        <a href="/" class="brand"><Image src={logo} alt="Virtual DDD" width={400} /></a>
        <button class="nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
          <span></span><span></span><span></span>
        </button>
        <nav class="site-nav" id="site-nav">
          {nav.map((n) => <a href={n.href} class:list={[{ current: isCurrent(n.href) }]}>{n.label}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-latest">
          <h3>Latest sessions</h3>
          <ul>
            {latest.map((s) => (
              <li>
                <a href={`/sessions/${s.id}/`}>
                  {s.data.featuredImage && <Image src={s.data.featuredImage} alt="" width={96} height={54} />}
                  <span>{s.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="footer-explore">
          <h3>Explore</h3>
          <ul>
            <li><a href="/sessions/">Online sessions</a></li>
            <li><a href="/open-space/">Open Space</a></li>
            <li><a href="/facilitating-archdes/">Facilitating Stories</a></li>
            <li><a href="/heuristics/">Heuristics</a></li>
            <li><a href="/ddd-crew/">ddd crew</a></li>
          </ul>
        </div>
        <div class="footer-about">
          <Image src={logo} alt="Virtual DDD" width={160} />
          <p>A community exploring Domain-Driven Design, software architecture &amp; design — together, online.</p>
          <Socials />
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p>© {year} Virtual DDD</p>
        <p class="footer-links">
          <a href="/code-of-conduct/">Code of Conduct</a>
          <a href="/privacy-policy/">Privacy</a>
          <a href="/ai-usage-on-this-site/">AI usage</a>
        </p>
      </div>
    </footer>

    <style>
      .site-header { position: sticky; top: 0; z-index: 20; background: var(--color-bg); border-bottom: 1px solid var(--color-border); }

      /* cyan social bar */
      .topbar { background: var(--color-primary); overflow: hidden; }
      .topbar-inner { display: flex; justify-content: flex-end; padding-block: var(--space-1); }
      .topbar :global(.socials a) { background: transparent; color: rgba(13, 14, 18, 0.7); width: 32px; height: 32px; }
      .topbar :global(.socials a:hover) { background: rgba(255, 255, 255, 0.25); color: #0d0e12; }

      /* stacked, centered */
      .header-inner { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-3); padding-block: var(--space-4); transition: padding 0.2s ease; }
      .brand { display: inline-flex; }
      .brand :global(img) { height: 175px; width: auto; transition: height 0.2s ease; }
      .site-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3) var(--space-6); font-family: var(--font-heading); font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; }
      .site-nav a { color: var(--color-text); padding-bottom: 2px; border-bottom: 2px solid transparent; }
      .site-nav a:hover { color: var(--color-primary); text-decoration: none; }
      .site-nav a.current { border-bottom-color: var(--color-accent); color: var(--color-primary); }

      /* shrink on scroll → slim horizontal bar */
      .site-header.scrolled .topbar { max-height: 0; padding: 0; }
      .site-header.scrolled .header-inner { flex-direction: row; justify-content: space-between; padding-block: var(--space-2); }
      .site-header.scrolled .brand :global(img) { height: 38px; }

      /* hamburger (mobile only) */
      .nav-toggle { display: none; flex-direction: column; align-items: center; justify-content: center; gap: 5px; width: 46px; height: 42px; background: none; border: 1px solid var(--color-border); cursor: pointer; padding: 0; }
      .nav-toggle span { display: block; width: 22px; height: 2px; background: var(--color-text); }

      @media (max-width: 820px) {
        .topbar { display: none; }
        .header-inner, .site-header.scrolled .header-inner { flex-direction: row; justify-content: space-between; padding-block: var(--space-3); }
        .brand :global(img), .site-header.scrolled .brand :global(img) { height: 40px; }
        .nav-toggle { display: inline-flex; }
        .site-nav {
          display: none; position: absolute; top: 100%; left: 0; right: 0;
          flex-direction: column; align-items: flex-start; gap: var(--space-3);
          background: var(--color-bg); border-bottom: 1px solid var(--color-border); padding: var(--space-4);
        }
        .site-header.nav-open .site-nav { display: flex; }
      }

      main { min-height: 60vh; padding-block: var(--space-12); }

      .site-footer { margin-top: var(--space-16); border-top: 1px solid var(--color-border); background: var(--color-surface); }
      .footer-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-8); padding-block: var(--space-12) var(--space-8); }
      .footer-grid h3 { font-size: var(--text-lg); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-4); }
      .footer-latest ul, .footer-explore ul { list-style: none; margin: 0; padding: 0; }
      .footer-latest li { margin-bottom: var(--space-3); }
      .footer-latest a { display: flex; gap: var(--space-3); align-items: center; color: var(--color-text); }
      .footer-latest :global(img) { width: 96px; height: 54px; object-fit: cover; flex: none; }
      .footer-latest span { font-size: var(--text-sm); line-height: 1.3; }
      .footer-explore li { margin-bottom: var(--space-2); }
      .footer-about :global(img) { height: 40px; width: auto; margin-bottom: var(--space-3); }
      .footer-about p { color: var(--color-text-muted); font-size: var(--text-sm); max-width: 26rem; }
      .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3); padding-block: var(--space-6); border-top: 1px solid var(--color-border); font-size: var(--text-sm); color: var(--color-text-muted); }
      .footer-links { display: flex; gap: var(--space-4); }

      @media (min-width: 800px) {
        .footer-grid { grid-template-columns: 1.2fr 0.8fr 1.3fr; gap: var(--space-12); }
      }
    </style>

    <script>
      const header = document.getElementById('site-header');
      if (header) {
        const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 60);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
        const toggle = header.querySelector('.nav-toggle');
        toggle?.addEventListener('click', () => {
          const open = header.classList.toggle('nav-open');
          toggle.setAttribute('aria-expanded', String(open));
        });
      }

      // Render every <time class="js-local"> in the visitor's local timezone.
      const dtFmt: Intl.DateTimeFormatOptions = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' };
      const dateFmt: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'long', year: 'numeric' };
      const shortFmt: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short', year: 'numeric' };
      document.querySelectorAll<HTMLElement>('.js-local').forEach((el) => {
        const iso = el.dataset.iso;
        if (!iso) return;
        const f = el.dataset.format === 'datetime' ? dtFmt : el.dataset.format === 'shortdate' ? shortFmt : dateFmt;
        el.textContent = new Date(iso).toLocaleString(undefined, f);
      });

      // Live countdown for any <* class="js-countdown" data-iso>.
      document.querySelectorAll<HTMLElement>('.js-countdown').forEach((el) => {
        const iso = el.dataset.iso;
        if (!iso) return;
        const target = new Date(iso).getTime();
        const tick = () => {
          const diff = target - Date.now();
          if (diff <= 0) { el.textContent = 'Happening now'; return; }
          const d = Math.floor(diff / 86400000);
          const h = Math.floor((diff % 86400000) / 3600000);
          const m = Math.floor((diff % 3600000) / 60000);
          const s = Math.floor((diff % 60000) / 1000);
          el.textContent = `Starts in ${d}d ${h}h ${m}m ${s}s`;
        };
        tick();
        setInterval(tick, 1000);
      });
    </script>
  </body>
</html>
