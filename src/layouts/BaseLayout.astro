---
// Latin subsets only. The default entrypoints ship latin-ext and devanagari
// too — 21 files where 6 are ever requested. A browser would not download the
// rest (unicode-range keeps them out), but they still travel in every deploy.
// Poppins 500 is not imported: nothing on the site asks for it.
import '@fontsource/rajdhani/latin-500.css';
import '@fontsource/rajdhani/latin-600.css';
import '@fontsource/rajdhani/latin-700.css';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
// The two above the fold: the body face and the face every heading uses.
// Without a preload they are discovered only after the CSS parses, which is a
// flash of fallback text on a slow connection.
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import rajdhani600 from '@fontsource/rajdhani/files/rajdhani-latin-600-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/patterns.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo-virtualddd.png';
import Socials from '../components/Socials.astro';
import ogDefault from '../assets/logo-virtualddd.png';
import { splitSessions } from '../lib/collections';
import { SITE_NAME, TWITTER } from '../lib/seo';
import { socialCard } from '../lib/social-card';

interface Props {
  title: string;
  description?: string;
  /** Absolute canonical URL. Defaults to this page's own URL. */
  canonical?: string;
  /** Structured data, generated from properties we already hold — never
   *  hand-authored in Notion. Emitted as a single JSON-LD script. */
  jsonLd?: Record<string, unknown>;
  /** Social card image. Pass the imported asset, not its `.src`: referencing
   *  the original would keep every unoptimised source file in the deploy. */
  image?: ImageMetadata;
  /** `article` for a single piece of content, `website` for an index. */
  ogType?: 'website' | 'article';
  /** Keep a page out of the index (thin or duplicate views). */
  noindex?: boolean;
  /** This page also exists as markdown, at `<path>index.md`. Set by the five
   *  content types; an agent reading the site gets the words with no HTML to
   *  strip. See src/lib/markdown-page.ts. */
  markdown?: boolean;
}
const {
  title, description, canonical, jsonLd, image, ogType = 'website', noindex = false,
  markdown = false,
} = Astro.props;

// Canonical defaults to the page's own URL, so every page has one rather than
// the eleven that did before. Astro.site is set in astro.config.mjs.
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const canonicalUrl = canonical ?? pageUrl;

const ogImage = await socialCard(Astro.site, image ?? ogDefault);

// Single source for the navigation. `section: true` lists it under "Explore"
// in the footer, which used to be a hand-maintained second copy; `nav: false`
// keeps a page out of the main bar while still giving it a home in the footer
// (nine items is already a crowded navigation).
const nav = [
  { href: '/', label: 'Home' },
  { href: '/sessions/', label: 'Online sessions', section: true },
  { href: '/facilitating-archdes/', label: 'Facilitating Stories', section: true },
  { href: '/open-space/', label: 'Open Space', section: true },
  { href: '/heuristics/', label: 'Heuristics', section: true },
  { href: '/ddd-crew/', label: 'ddd crew', section: true },
  { href: '/podcasts/', label: 'Podcasts', section: true, nav: false },
  { href: '/organisers/', label: 'Organisers', section: true, nav: false },
  { href: '/book-club/', label: 'Book club', section: true, nav: false },
  { href: '/about-us/', label: 'About us' },
];
const mainNav = nav.filter((n) => n.nav !== false);
const sections = nav.filter((n) => n.section);
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

// Latest sessions for the footer (most recent first, upcoming included).
const { all } = await splitSessions();
const latest = [...all].sort((a, b) => +new Date(b.data.datetime) - +new Date(a.data.datetime)).slice(0, 3);
const year = new Date().getFullYear();

// Both are public by design — they end up in the page source — so they are
// repository *variables*, not secrets. Only in a production build: a dev server
// counting its own page loads is noise in the one number we keep.
//
// The script URL is a variable rather than a constant because Plausible's
// hosted and self-hosted builds serve the identical tag from different hosts.
// Moving the analytics onto our own machine later is then one value, not a
// re-instrumentation of 328 pages.
const analyticsSrc = import.meta.env.PROD ? import.meta.env.PUBLIC_ANALYTICS_SRC : undefined;
const analyticsDomain = import.meta.env.PROD ? import.meta.env.PUBLIC_ANALYTICS_DOMAIN : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <!-- Marks that scripting is available, before anything paints, so the
         mobile nav can ship open for everyone else without a flash. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preload" as="font" type="font/woff2" href={poppins400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={rajdhani600} crossorigin />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} — sessions and stories`} href="/rss.xml" />
    {markdown && (
      <link rel="alternate" type="text/markdown" title={`${title} — markdown`} href={`${Astro.url.pathname}index.md`} />
    )}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/* Counts page views and nothing else: no cookies, no cross-site
        identifier, nothing that needs a consent banner — see the privacy
        policy, which has to keep saying something true. Absent unless both
        variables are set, so a fork, a local build and a preview deploy are
        silent by default rather than polluting the real numbers. `defer` and
        the absence of any fallback are deliberate: if the host is unreachable
        the page is unaffected and the visit is simply not counted. */}
    {analyticsSrc && analyticsDomain && (
      <script is:inline defer src={analyticsSrc} data-domain={analyticsDomain}></script>
    )}
  </head>
  <body>
    <!-- Every page repeats 14 navigation links; without this a keyboard or
         switch user tabs through all of them before reaching the content. -->
    <a class="skip-link" href="#main" data-test="skip-link">Skip to content</a>
    <header class="site-header" id="site-header" data-test="site-header">
      <div class="topbar">
        <div class="wrap topbar-inner"><Socials /></div>
      </div>
      <div class="wrap header-inner">
        <a href="/" class="brand"><Image src={logo} alt="Virtual DDD" width={400} /></a>
        <button class="nav-toggle" data-test="nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
          <span></span><span></span><span></span>
        </button>
        <nav class="site-nav" id="site-nav" data-test="nav">
          {mainNav.map((n) => <a href={n.href} class:list={[{ current: isCurrent(n.href) }]}>{n.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-latest">
          <h2>Latest sessions</h2>
          <ul>
            {latest.map((s) => (
              <li>
                <a href={`/sessions/${s.id}/`}>
                  {s.data.featuredImage && <Image src={s.data.featuredImage} alt="" width={96} height={54} />}
                  <span>{s.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="footer-explore">
          <h2>Explore</h2>
          <ul>
            {sections.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
          </ul>
        </div>
        <div class="footer-about">
          <Image src={logo} alt="Virtual DDD" width={160} />
          <p>A community exploring Domain-Driven Design, software architecture &amp; design — together, online.</p>
          <Socials />
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p>© {year} Virtual Domain-Driven Design | Brand design by Art of Design</p>
        <p class="footer-links">
          <a href="/code-of-conduct/">Code of Conduct</a>
          <a href="/privacy-policy/">Privacy</a>
          <a href="/ai-usage-on-this-site/">AI usage</a>
        </p>
      </div>
    </footer>

    <style>
      .site-header { position: sticky; top: 0; z-index: 20; background: var(--color-bg); border-bottom: 1px solid var(--color-border); }

      /* Out of the flow, with `--header-h` holding the space it used to take.
         Sticky and in the flow, shrinking the header removed 235px from the
         page and the browser returned them as scroll, which flipped the header
         straight back — the desktop page could not be scrolled past its own
         header. The reasoning, and why no threshold fixes it, is in
         src/scripts/header.ts. Without JavaScript nothing ever collapses, so
         the sticky header above is already right and this never applies. */
      :global(html.js-header-fixed) .site-header { position: fixed; left: 0; right: 0; }
      :global(html.js-header-fixed) body { padding-top: var(--header-h); }
      /* Measuring flips `.scrolled` off and back within the frame; animating
         that would show as a twitch on every resize. */
      .site-header.js-measuring .header-inner,
      .site-header.js-measuring .brand :global(img) { transition: none; }

      /* cyan social bar */
      .topbar { background: var(--color-primary); overflow: hidden; }
      .topbar-inner { display: flex; justify-content: flex-end; padding-block: var(--space-1); }
      .topbar :global(.socials a) { background: transparent; color: rgba(13, 14, 18, 0.7); width: 32px; height: 32px; }
      .topbar :global(.socials a:hover) { background: var(--overlay-white-soft); color: #0d0e12; }

      /* stacked, centered */
      .header-inner { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-3); padding-block: var(--space-4); transition: padding 0.2s ease; }
      .brand { display: inline-flex; }
      .brand :global(img) { height: 175px; width: auto; transition: height 0.2s ease; }
      .site-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3) var(--space-6); font-family: var(--font-heading); font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; }
      .site-nav a { color: var(--color-text); padding-bottom: 2px; border-bottom: 2px solid transparent; }
      .site-nav a:hover { color: var(--color-primary); text-decoration: none; }
      .site-nav a.current { border-bottom-color: var(--color-accent); color: var(--color-primary); }

      /* shrink on scroll → slim horizontal bar */
      .site-header.scrolled .topbar { max-height: 0; padding: 0; }
      .site-header.scrolled .header-inner { flex-direction: row; justify-content: space-between; padding-block: var(--space-2); }
      .site-header.scrolled .brand :global(img) { height: 38px; }

      /* hamburger (mobile only) */
      .nav-toggle { display: none; flex-direction: column; align-items: center; justify-content: center; gap: 5px; width: 46px; height: 42px; background: none; border: 1px solid var(--color-border); cursor: pointer; padding: 0; }
      .nav-toggle span { display: block; width: 22px; height: 2px; background: var(--color-text); }

      @media (max-width: 799.98px) {
        .topbar { display: none; }
        .header-inner, .site-header.scrolled .header-inner { flex-direction: row; justify-content: space-between; flex-wrap: wrap; padding-block: var(--space-3); }
        .brand :global(img), .site-header.scrolled .brand :global(img) { height: 40px; }

        /* Without JavaScript the navigation is simply there, stacked under the
           brand, and the hamburger stays hidden — a button that cannot open
           anything is worse than no button. Every one of the seven links used
           to be unreachable on a phone with scripting off. */
        .site-nav {
          width: 100%; display: flex; flex-direction: column; align-items: flex-start;
          gap: var(--space-3); padding-top: var(--space-3);
        }

        /* With JavaScript, collapse it behind the hamburger as before. */
        :global(html.js) .nav-toggle { display: inline-flex; }
        :global(html.js) .site-nav {
          display: none; width: auto; position: absolute; top: 100%; left: 0; right: 0;
          padding: var(--space-4); padding-top: var(--space-4);
          background: var(--color-bg); border-bottom: 1px solid var(--color-border);
        }
        :global(html.js) .site-header.nav-open .site-nav { display: flex; }
      }

      main { min-height: 60vh; padding-block: var(--space-12); }

      .site-footer { margin-top: var(--space-16); border-top: 1px solid var(--color-border); background: var(--color-surface); }
      .footer-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-8); padding-block: var(--space-12) var(--space-8); }
      .footer-grid h2 { font-size: var(--text-lg); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-4); }
      .footer-latest ul, .footer-explore ul { list-style: none; margin: 0; padding: 0; }
      .footer-latest li { margin-bottom: var(--space-3); }
      .footer-latest a { display: flex; gap: var(--space-3); align-items: center; color: var(--color-text); }
      .footer-latest :global(img) { width: 96px; height: 54px; object-fit: cover; flex: none; }
      .footer-latest span { font-size: var(--text-sm); line-height: 1.3; }
      .footer-explore li { margin-bottom: var(--space-2); }
      /* A 24px target: these sit in a list, not in a sentence, so the inline
         exception to WCAG 2.5.8 does not apply and 23px was one pixel short. */
      .footer-explore a { display: inline-flex; align-items: center; min-height: 24px; }
      .footer-about :global(img) { height: 40px; width: auto; margin-bottom: var(--space-3); }
      .footer-about p { color: var(--color-text-muted); font-size: var(--text-sm); max-width: 26rem; }
      .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3); padding-block: var(--space-6); border-top: 1px solid var(--color-border); font-size: var(--text-sm); color: var(--color-text-muted); }
      .footer-links { display: flex; gap: var(--space-4); }
      .footer-links a { display: inline-flex; align-items: center; min-height: 24px; }

      @media (min-width: 800px) {
        .footer-grid { grid-template-columns: 1.2fr 0.8fr 1.3fr; gap: var(--space-12); }
      }
    </style>

    <script>
      // Every behaviour on this page is a module, so each can be read, changed
      // and reasoned about on its own. See src/scripts/.
      import { initHeader } from '../scripts/header';
      import { initLocalTime } from '../scripts/local-time';
      import { initSessionTiming } from '../scripts/session-timing';

      initHeader();
      initLocalTime();
      initSessionTiming();
    </script>
  </body>
</html>
