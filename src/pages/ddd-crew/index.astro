---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { collectionPage, topTrail } from '../../lib/seo';
import { byGallery, categoryRank, type CrewConfig } from '../../lib/ddd-crew';
import config from '../../../data/ddd-crew.json';

// The whole gallery — what is on it, in what order — is the 🛠️ ddd-crew
// database in Notion, synced into data/ddd-crew.json. Two kinds of card come
// out of one list: a repo we may republish links to our own page, and one we
// may not links out to GitHub. They interleave, because "the free resources
// list" belongs at the end of Getting started rather than in a footnote.
const crew = config as CrewConfig;
const pages = new Map((await getCollection('dddCrew')).map((e) => [e.id, e]));

// A tool is only ours to serve once its README has actually been fetched. Until
// then it renders as a link-out, so the hour between ticking Republished and
// the next ddd-crew sync shows a working card rather than a broken link.
const tools = byGallery(crew).map((t) => ({ tool: t, page: t.republished ? pages.get(t.repo) : undefined }));

// Grouped from the tools rather than from a list of category names, so a
// category added in Notion cannot be silently left off the page.
const rank = categoryRank(crew.categories);
const grouped = [...new Set(tools.map((t) => t.tool.category))]
  .sort((a, b) => rank(a) - rank(b))
  .map((cat) => ({ cat: cat || 'More tools', items: tools.filter((t) => t.tool.category === cat) }));

const description =
  'Community Domain-Driven Design tools, canvases and guides from the ddd-crew — republished with attribution under the licence each repository sets.';
// Only the republished tools are listed: the link-outs are somebody else's
// pages, and an ItemList of them would claim this page holds them.
const jsonLd = collectionPage(Astro.site, {
  url: new URL('/ddd-crew/', Astro.site).toString(),
  name: 'ddd-crew tools',
  description,
  items: tools.filter((t) => t.page).map(({ tool, page }) => ({
    name: page!.data.title,
    url: new URL(`/ddd-crew/${tool.repo}/`, Astro.site).toString(),
  })),
  trail: topTrail('ddd-crew tools', '/ddd-crew/'),
});

---

<BaseLayout title="ddd-crew — Virtual DDD" description={description} jsonLd={jsonLd}>
  <section class="hero hero-band hero-band--padded">
    <div class="page-wash" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow eyebrow--pink">ddd crew</p>
      <h1>Community tools for Domain-Driven Design</h1>
      <p class="lead">
        The <a href="https://github.com/ddd-crew">ddd-crew</a> is an open, community-run collection of
        practical DDD tools — canvases, modelling processes and reference guides. We republish them here so
        they're easy to browse, always crediting the original authors.
      </p>
      <p class="licence">
        Everything republished here is by the ddd-crew and its contributors, under the licence each
        repository sets: mostly <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>,
        and each page says which. Every tool links back to its source repository and canonical version.
      </p>
    </div>
  </section>

  <div class="wrap">
    {grouped.map((g) => (
      <section class="cat">
        <h2 class="eyebrow eyebrow--cyan">{g.cat}</h2>
        <div class="grid">
          {g.items.map(({ tool, page }) => (
            page ? (
              <a class="card tool" href={`/ddd-crew/${tool.repo}/`}>
                <div class="tool-thumb">
                  {page.data.heroImage ? <Image src={page.data.heroImage} alt="" width={560} /> : <div class="card-thumb-ph"></div>}
                </div>
                <div class="card-body tool-body">
                  <h3 class="card-title">{page.data.title}</h3>
                  {page.data.description && <p class="tool-desc">{page.data.description}</p>}
                  <span class="card-more">Open →</span>
                </div>
              </a>
            ) : (
              <a class="card card--offsite tool" href={tool.link}>
                <div class="card-body tool-body">
                  <h3 class="card-title">{tool.name}</h3>
                  {tool.note && <p class="tool-desc">{tool.note}</p>}
                  <span class="card-more">On GitHub ↗</span>
                </div>
              </a>
            )
          ))}
        </div>
      </section>
    ))}
  </div>

  <style>
    .hero h1 { font-size: clamp(2rem, 3.4vw + 1rem, var(--text-4xl)); line-height: 1.06; max-width: 20ch; margin: 0 0 var(--space-6); }
    .lead { margin: 0 0 var(--space-4); }
    .licence { color: var(--color-text-muted); max-width: 52rem; font-size: var(--text-sm); line-height: 1.7; margin: 0; }

    .cat { margin-top: var(--space-16); }
    .grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
    @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 900px) { .grid { grid-template-columns: repeat(3, 1fr); } }

    /* Card chrome comes from .card; canvases are diagrams, so the thumbnail is
       letterboxed on white rather than cropped to fill. */
    .tool-thumb { aspect-ratio: 16 / 10; background: #fff; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: var(--space-3); }
    .tool-thumb :global(img) { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; display: block; }
    .tool-body { padding: var(--space-5) var(--space-6) var(--space-6); display: flex; flex-direction: column; flex: 1; }
    .tool-body .card-title { font-size: var(--text-xl); margin-bottom: var(--space-2); }
    .tool-desc { color: var(--color-text-muted); font-size: var(--text-sm); line-height: 1.6; margin: 0; }

  </style>
</BaseLayout>
