---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import art1 from '../assets/heur-articles/article_what_do_typical_design_heuristics_look_like.jpg';
import art2 from '../assets/heur-articles/article_architecture_cleus_heuristics_part_I.jpg';
import art3 from '../assets/heur-articles/article_architecture_cleus_heuristics_part_II.jpg';
import { HEURISTIC_TYPES } from '../lib/heuristics';

const all = await getCollection('heuristics');

const articles = [
  { title: 'What do typical design heuristics look like?', by: 'Rebecca Wirfs-Brock', href: 'https://wirfs-brock.com/blog/2019/04/04/what-do-typical-design-heuristics-look/', img: art1 },
  { title: 'Architecture Clues: Heuristics, Part i — SCARS', by: 'Ruth Malan', href: 'https://www.linkedin.com/pulse/architecture-clues-heuristics-part-i-scars-ruth-malan/', img: art2 },
  { title: 'Architecture Clues: Heuristics, Part ii — Decisions and Change', by: 'Ruth Malan', href: 'https://www.linkedin.com/pulse/architecture-clues-heuristics-part-ii-decisions-change-ruth-malan/', img: art3 },
];

const banners = HEURISTIC_TYPES.map((t) => ({
  ...t,
  href: `/heuristics/?type=${t.key}`,
  count: all.filter((h) => h.data.type[0] === t.key).length,
}));

const videos = ['TP3xTZi_Qn8', '9ZgSz6xAfL8'];
---

<BaseLayout
  title="About our heuristics — Virtual DDD"
  description="Further reading on heuristics, how to contribute your own, the collection's licence, the three kinds we collect, and talks on design heuristics."
>
  <div class="wrap page">
    <p class="detail-back"><a href="/heuristics/">← Back to heuristics</a></p>
    <p class="eyebrow eyebrow--pink">About the collection</p>
    <h1>About the heuristics</h1>

    <section class="block">
      <h2>Further reading</h2>
      <div class="articles">
        {articles.map((a) => (
          <a class="article" href={a.href} target="_blank" rel="noopener">
            <div class="article-img"><Image src={a.img} alt="" width={480} /></div>
            <div class="article-body">
              <h3>{a.title}</h3>
              <p class="article-by">{a.by} ↗</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <div class="two-up">
      <section class="block narrow">
        <h2>Submit your own heuristic</h2>
        <p>
          Got a rule of thumb that helps you design better systems? We'd love to add it. Share it with us
          in <a href="https://discord.gg/tRJkcsFDKN">our Discord community</a> or email{' '}
          <a href="mailto:info@virtualddd.com">info@virtualddd.com</a>, and we'll help curate it into the
          collection.
        </p>
      </section>

      <section class="block narrow">
        <h2>Using the information</h2>
        <p>
          All the information about heuristics on this site is{' '}
          <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">Creative Commons Attribution-ShareAlike</a>.
          Please remix, adapt, and build upon the work here — even for commercial purposes — as long as you
          credit the authors and submitter and license your new creations under the identical terms.
        </p>
      </section>
    </div>

    <section class="block">
      <h2>Browse by type</h2>
      <div class="tbanner-grid">
        {banners.map((t) => (
          <a class="tbanner scrim" href={t.href} style={`background-image: url(${t.bg.src})`}>
            <span class="tbanner-body">
              <span class="tbanner-title">{t.title}</span>
              <span class="tbanner-text">{t.text}</span>
              <span class="tbanner-count">{t.count} heuristics ››</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="block">
      <h2>Talks on design heuristics</h2>
      <div class="videos">
        {videos.map((id) => (
          <div class="video">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${id}`}
              title="Talk on design heuristics"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
        ))}
      </div>
    </section>
  </div>

  <style>
    .page { padding-block: var(--space-8) var(--space-16); }
    .detail-back { font-size: var(--text-sm); margin-bottom: var(--space-4); }
    .page h1 { margin: 0 0 var(--space-12); }

    .block { margin-bottom: var(--space-16); }
    .block h2 { font-size: var(--text-2xl); margin: 0 0 var(--space-5); }
    .block p { color: var(--color-text-muted); line-height: 1.75; margin: 0; }
    .block.narrow p { max-width: 34rem; }

    /* Submit + Creative Commons side by side */
    .two-up { display: grid; grid-template-columns: 1fr; gap: var(--space-8); margin-bottom: var(--space-16); }
    @media (min-width: 800px) { .two-up { grid-template-columns: 1fr 1fr; gap: var(--space-12); } .two-up .block { margin-bottom: 0; } }

    /* Further reading */
    .articles { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
    @media (min-width: 800px) { .articles { grid-template-columns: repeat(3, 1fr); } }
    .article { display: flex; flex-direction: column; background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); transition: border-color 0.15s, transform 0.15s; }
    .article:hover { border-color: color-mix(in srgb, var(--color-primary) 55%, var(--color-border)); transform: translateY(-3px); text-decoration: none; }
    .article-img { aspect-ratio: 16 / 10; overflow: hidden; }
    .article-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .article-body { padding: var(--space-4) var(--space-5) var(--space-5); }
    .article-body h3 { font-size: var(--text-base); margin: 0 0 var(--space-2); line-height: 1.3; }
    .article-by { margin: 0; font-size: var(--text-sm); color: var(--color-text-muted); }

    /* Type banners come from patterns.css (.tbanner / .tbanner-grid). */

    /* Videos */
    .videos { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
    @media (min-width: 800px) { .videos { grid-template-columns: 1fr 1fr; } }
  </style>
</BaseLayout>
