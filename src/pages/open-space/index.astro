---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeaserCard from '../../components/TeaserCard.astro';
import { getCollection } from 'astro:content';
import { iso, shortDate } from '../../lib/dates';
import { excerpt } from '../../lib/excerpt';

const all = (await getCollection('openSpaces')).sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date),
);
const now = Date.now();
const upcoming = all
  .filter((s) => s.data.status === 'Published' && +new Date(s.data.date) > now)
  .sort((a, b) => +new Date(a.data.date) - +new Date(b.data.date));
const past = all.filter((s) => !(s.data.status === 'Published' && +new Date(s.data.date) > now));
---

<BaseLayout
  title="Open Space — Virtual DDD"
  description="Online Open Spaces from Virtual DDD — participant-led unconferences where the community sets the agenda and explores software design together."
>
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow eyebrow--pink">Open Space</p>
      <h1>Where the community sets the agenda</h1>
      <p class="lead">
        Our Open Spaces are participant-led online unconferences. There are no fixed talks — everyone who
        joins can propose a topic, and together the room decides what to explore. It's the "hallway track"
        of a conference turned into the whole event: conversations go wherever the attendees take them.
      </p>
    </div>
  </section>

  <div class="wrap">
    {upcoming.length > 0 && (
      <section class="up">
        <p class="eyebrow eyebrow--cyan">Upcoming</p>
        <div class="grid">
          {upcoming.map((s) => (
            <TeaserCard
              class="card--feature card--upcoming"
              href={`/open-space/${s.id}/`}
              title={s.data.title}
              img={s.data.featuredImage}
              imgWidth={640}
              loading="eager"
              iso={iso(s.data.date)}
              dateFallback={shortDate(s.data.date)}
              accentMeta
              more="RSVP & details →"
            />
          ))}
        </div>
      </section>
    )}

    <section class="archive">
      <p class="eyebrow eyebrow--cyan">Past open spaces</p>
      <div class="grid">
        {past.map((s) => (
          <TeaserCard
            class="card--feature"
            href={`/open-space/${s.id}/`}
            title={s.data.title}
            img={s.data.featuredImage}
            imgWidth={640}
            iso={iso(s.data.date)}
            dateFallback={shortDate(s.data.date)}
            accentMeta
            excerpt={excerpt(s.body ?? '', s.data.seoMetadescription ?? '')}
            more="Read more →"
          />
        ))}
      </div>
    </section>
  </div>

  <style>
    .hero { position: relative; overflow: hidden; padding-block: var(--space-16) var(--space-12); border-bottom: 1px solid var(--color-border); margin-top: calc(-1 * var(--space-12)); }
    .hero-glow { position: absolute; inset: 0; pointer-events: none; background:
      radial-gradient(120% 90% at 0% 0%, rgba(22, 189, 232, 0.16), transparent 55%),
      radial-gradient(90% 80% at 100% 15%, rgba(236, 95, 166, 0.12), transparent 60%); }
    .hero-inner { position: relative; }
    .hero h1 { font-size: clamp(2rem, 3.4vw + 1rem, var(--text-4xl)); line-height: 1.06; max-width: 20ch; margin: 0 0 var(--space-6); }
    .lead { color: var(--color-text-muted); max-width: 52rem; line-height: 1.75; margin: 0; }

    .up { margin-top: var(--space-16); }
    .archive { margin-block: var(--space-16); }
    /* Cards come from patterns.css; the grid is 1 / 2 / 3 columns. */
    .grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
    @media (min-width: 620px) { .grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 960px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  </style>
</BaseLayout>
