---
import { openSpaceJsonLd, pageTitle, socialCard, trail } from '../../lib/seo';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SideExtras from '../../components/SideExtras.astro';
import PrevNext from '../../components/PrevNext.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { youtubeEmbed } from '../../lib/embeds';
import { excerpt } from '../../lib/excerpt';
import { iso as toIso, longDateTime, shortDate } from '../../lib/dates';
import { siblings, type Teaser } from '../../lib/collections';

export async function getStaticPaths() {
  const items = await getCollection('openSpaces');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry, items } }));
}

const { entry, items } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const videoEmbed = youtubeEmbed(d.video);
// Only embed podcast players we know render as an iframe (captivate). Libsyn oembed
// endpoints in the legacy data aren't real players, so skip them.
const podcastEmbed = d.podcast?.includes('player.captivate.fm') ? d.podcast : null;

const isUpcoming = d.status === 'Published' && new Date(d.date) > new Date();
const iso = toIso(d.date);
const dateStr = longDateTime(d.date);

const byDate = [...items].sort((a, b) => +new Date(a.data.date) - +new Date(b.data.date));
const { prev, next } = siblings(byDate, entry.id);

// Latest open spaces for the sidebar (most recent, excluding this one).
const latest: Teaser[] = [...items]
  .filter((s) => s.id !== entry.id)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
  .slice(0, 3)
  .map((s) => ({
    href: `/open-space/${s.id}/`,
    title: s.data.title,
    img: s.data.featuredImage,
    iso: toIso(s.data.date),
    fallback: shortDate(s.data.date),
  }));
// SEO and structured data. An open space is an Event too — participant-led,
// but online, dated and recorded like a session.
const url = new URL(`/open-space/${entry.id}/`, Astro.site).toString();
const description =
  d.seoMetadescription ?? excerpt(entry.body ?? '', `${d.title} — a Virtual DDD open space.`, 155);
const jsonLd = openSpaceJsonLd(Astro.site, entry, {
  url,
  description,
  image: d.featuredImage ? await socialCard(Astro.site, d.featuredImage) : undefined,
  trail: trail('openSpace', d.title, `/open-space/${entry.id}/`),
});

---

<BaseLayout
  title={pageTitle(d.seoTitle ?? d.title)}
  description={description}
  image={d.featuredImage}
  ogType="article"
  jsonLd={jsonLd}
  markdown
>
  <article class="os detail wrap">
    <div class="detail-head">
      <p class="detail-back"><a href="/open-space/">← All open spaces</a></p>
      <p class="eyebrow eyebrow--pink">Open Space</p>
      <h1>{d.title}</h1>
      <p class="os-when"><time class="js-local" data-format="datetime" datetime={iso} data-iso={iso}>{dateStr}</time></p>

      {isUpcoming && (d.tickets || d.meetup) && (
        <div class="cta">
          {d.tickets && <a class="btn btn--accent" href={d.tickets}>Get tickets</a>}
          {d.meetup && <a class="btn btn--ghost" href={d.meetup}>Join on Meetup</a>}
        </div>
      )}

      {videoEmbed ? (
        <div class="video">
          <iframe src={videoEmbed} title={d.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
      ) : d.featuredImage ? (
        <Image class="media-hero" src={d.featuredImage} alt={d.title} width={920} />
      ) : null}

      {podcastEmbed && (
        <iframe class="podcast" src={podcastEmbed} title="Podcast player" loading="lazy" width="100%" height="170"></iframe>
      )}
    </div>

    <aside class="detail-side">
      {(d.miro || d.meetup || d.tickets) && (
        <div class="side-card">
          <p class="side-links">
            {d.tickets && <a href={d.tickets}>Tickets ↗</a>}
            {d.meetup && <a href={d.meetup}>Meetup event ↗</a>}
            {d.miro && <a href={d.miro}>Miro board ↗</a>}
          </p>
        </div>
      )}

      {d.tags.length > 0 && (
        <div class="side-block">
          <p class="eyebrow eyebrow--cyan">Tags</p>
          <div class="chips">{d.tags.map((t) => <span class="chip chip--outline">{t}</span>)}</div>
        </div>
      )}

      <SideExtras latest={latest} latestLabel="More open spaces" latestAllHref="/open-space/" />
    </aside>

    <div class="detail-body">
      <div class="prose-body"><Content /></div>
      <PrevNext
        noun="open space"
        prev={prev && { href: `/open-space/${prev.id}/`, title: prev.data.title }}
        next={next && { href: `/open-space/${next.id}/`, title: next.data.title }}
      />
    </div>
  </article>

  <style>
    /* Eyebrow, layout, media, prose and prev/next come from patterns.css. */
    .detail-head h1 { margin: 0 0 var(--space-3); }
    .os-when { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); color: var(--color-text); margin: 0 0 var(--space-6); }
    .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-6); }

    .side-card { background: var(--color-surface); border: 1px solid var(--color-border); padding: var(--space-6); }
    .side-card .side-links { display: flex; flex-direction: column; gap: var(--space-2); margin: 0; }
    .side-block { margin-top: var(--space-8); }
    .side-block .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }

    /* Agenda tables in the body carry long URLs. */
    .prose-body :global(a) { word-break: break-word; }
  </style>
</BaseLayout>
