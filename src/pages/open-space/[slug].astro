---
// PLACEHOLDER route — real design is the Phase 5 loop. URL: /open-space/<slug>/
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const items = await getCollection('openSpaces');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.seoTitle ?? d.title} — Virtual DDD</title>
    {d.seoMetadescription && <meta name="description" content={d.seoMetadescription} />}
  </head>
  <body>
    <main style="max-width: 42rem; margin: 2rem auto; padding: 0 1rem;">
      <p><a href="/open-space/">← All open spaces</a></p>
      <h1>{d.title}</h1>
      <p>{new Date(d.date).toLocaleDateString()}</p>
      {d.featuredImage && <Image src={d.featuredImage} alt={d.title} width={800} style="max-width:100%;height:auto;" />}
      {d.video && <p><a href={d.video}>▶ Watch the recording</a></p>}
      <article><Content /></article>
    </main>
  </body>
</html>
