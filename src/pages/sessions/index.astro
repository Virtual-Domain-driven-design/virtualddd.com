---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SessionCard from '../../components/SessionCard.astro';
import { Image } from 'astro:assets';
import { splitSessions, tagOptions } from '../../lib/collections';
import { iso, longDateTime } from '../../lib/dates';

const { upcoming, past } = await splitSessions();

const featured = upcoming[0];
const f = featured?.data;
const featuredIso = f ? iso(f.datetime) : '';
const featuredDate = f ? longDateTime(f.datetime) : '';

const tags = tagOptions(past);
const types = ['talk', 'debate', 'panel-discussion', 'fireside-chat', 'hands-on'];
---

<BaseLayout
  title="Online sessions — Virtual DDD"
  description="Live online meetups on Domain-Driven Design, software architecture and design."
>
  <div class="wrap">
    <h1>Online sessions</h1>

    {featured && (
      <section class="hero" aria-label="Next session">
        <p class="eyebrow eyebrow--pink">Next session</p>
        <div class="hero-card">
          <div class="hero-img">
            {f!.featuredImage ? <Image src={f!.featuredImage} alt="" width={720} /> : <div class="card-thumb-ph"></div>}
          </div>
          <div class="hero-body">
            <div class="badges">
              {f!.typeOfSession && <span class="badge badge--type">{f!.typeOfSession}</span>}
              {f!.level?.map((l) => <span class="badge">{l}</span>)}
            </div>
            <h2><a href={`/sessions/${featured.id}/`}>{f!.title}</a></h2>
            <p class="hero-date"><time class="js-local" data-format="datetime" datetime={featuredIso} data-iso={featuredIso}>{featuredDate}</time></p>
            {f!.organiser && <p class="hero-host">Hosted by {f!.organiser}</p>}
            <div class="hero-cta">
              {f!.humantix
                ? <a class="btn btn--accent" href={f!.humantix}>RSVP to attend</a>
                : <a class="btn btn--accent" href={`/sessions/${featured.id}/`}>More info →</a>}
              {f!.humantix && <a class="btn btn--ghost" href={`/sessions/${featured.id}/`}>More info →</a>}
            </div>
            {(f!.meet || f!.video) && (
              <div class="hero-live js-live" data-iso={featuredIso}>
                <span class="hero-live-label">Starting soon</span>
                {f!.meet && <a class="btn" href={f!.meet}>Join Google Meet</a>}
                {f!.video && <a class="btn btn--ghost" href={f!.video}>Watch livestream</a>}
              </div>
            )}
          </div>
        </div>
        {upcoming.length > 1 && (
          <div class="grid-cards more-upcoming">{upcoming.slice(1).map((s) => <SessionCard session={s} />)}</div>
        )}
      </section>
    )}

    <section class="archive">
      <h2>Past sessions</h2>

      <div class="filters">
        <input type="search" id="q" placeholder="Search title or tag…" aria-label="Search sessions" />
        <select id="f-level" aria-label="Filter by level">
          <option value="">All levels</option>
          <option value="Beginner">Beginner</option>
          <option value="Intermediate">Intermediate</option>
          <option value="Advanced">Advanced</option>
        </select>
        <select id="f-type" aria-label="Filter by type">
          <option value="">All types</option>
          {types.map((t) => <option value={t}>{t}</option>)}
        </select>
        <select id="f-tag" aria-label="Filter by tag">
          <option value="">All tags</option>
          {tags.map((t) => <option value={t}>{t}</option>)}
        </select>
        <button id="f-reset" class="filter-reset" type="button">Reset</button>
        <span class="result-count" id="count"></span>
      </div>

      <div class="grid-cards" id="cards">{past.map((s) => <SessionCard session={s} />)}</div>
      <p class="no-results" id="noresults" hidden>No sessions match your filters.</p>
      <div class="load-wrap"><button id="load-more" type="button" class="btn btn--ghost">Load more</button></div>
    </section>
  </div>

  <style>
    .archive h2 { margin-top: var(--space-8); }

    /* Upcoming hero */
    .hero { margin-bottom: var(--space-16); }
    .hero-card { display: grid; grid-template-columns: 1fr; background: var(--color-surface); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
    .hero-img { aspect-ratio: 16 / 9; background: var(--color-surface); }
    .hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .hero-body { padding: var(--space-8); }
    .hero-body .badges { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-3); }
    .hero-body h2 { font-size: var(--text-3xl); margin: 0 0 var(--space-3); }
    .hero-body h2 a { color: var(--color-text); }
    .hero-date { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); margin: 0 0 var(--space-1); }
    .hero-host { color: var(--color-text-muted); margin: 0 0 var(--space-6); }
    .hero-cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }
    .hero-live { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-4); }
    .hero-live-label { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--text-sm); color: var(--color-primary); }
    .more-upcoming { margin-top: var(--space-6); }

    @media (min-width: 800px) {
      .hero-card { grid-template-columns: 1.1fr 1fr; }
      .hero-img { aspect-ratio: auto; }
    }

    /* Filters, cards and the result count come from patterns.css. */
    .result-count { margin-left: auto; }
    .grid-cards { --card-min: 16.25rem; }
    .load-wrap { text-align: center; margin-top: var(--space-8); }
  </style>

  <script>
    import { applyUrlFilter } from '../../lib/filter-url';

    const cards = Array.from(document.querySelectorAll<HTMLElement>('#cards .card'));
    const q = document.getElementById('q') as HTMLInputElement;
    const fLevel = document.getElementById('f-level') as HTMLSelectElement;
    const fType = document.getElementById('f-type') as HTMLSelectElement;
    const fTag = document.getElementById('f-tag') as HTMLSelectElement;
    const reset = document.getElementById('f-reset') as HTMLButtonElement;
    const count = document.getElementById('count') as HTMLElement;
    const noResults = document.getElementById('noresults') as HTMLElement;
    const loadMore = document.getElementById('load-more') as HTMLButtonElement;
    const STEP = 30;
    let limit = STEP;

    function matches(c: HTMLElement): boolean {
      const term = q.value.trim().toLowerCase();
      const lvl = fLevel.value, typ = fType.value, tag = fTag.value.toLowerCase();
      const d = c.dataset;
      const okTerm = !term || (d.title ?? '').includes(term) || (d.tags ?? '').includes(term);
      const okLvl = !lvl || (d.level ?? '').includes(lvl);
      const okTyp = !typ || d.type === typ;
      const okTag = !tag || ('|' + (d.tags ?? '') + '|').includes('|' + tag + '|');
      return okTerm && okLvl && okTyp && okTag;
    }

    function apply(resetLimit = false) {
      if (resetLimit) limit = STEP;
      const matched = cards.filter(matches);
      cards.forEach((c) => (c.hidden = true));
      matched.slice(0, limit).forEach((c) => (c.hidden = false));
      count.textContent = `${matched.length} session${matched.length === 1 ? '' : 's'}`;
      noResults.hidden = matched.length > 0;
      loadMore.hidden = matched.length <= limit;
    }

    [q, fLevel, fType, fTag].forEach((el) => el.addEventListener('input', () => apply(true)));
    reset.addEventListener('click', () => {
      q.value = ''; fLevel.value = ''; fType.value = ''; fTag.value = '';
      apply(true);
    });
    loadMore.addEventListener('click', () => { limit += STEP; apply(false); });

    // Landing from a legacy /sessions_tag/<tag>/ URL.
    applyUrlFilter(fTag);
    apply(true);
  </script>
</BaseLayout>
