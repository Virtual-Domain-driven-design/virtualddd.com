---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SessionCard from '../../components/SessionCard.astro';
import CardFilter from '../../components/CardFilter.astro';
import ListenOn from '../../components/ListenOn.astro';
import UpcomingThen from '../../components/UpcomingThen.astro';
import NoSessionsYet from '../../components/NoSessionsYet.astro';
import DiscordCard from '../../components/DiscordCard.astro';
import { Image } from 'astro:assets';
import { splitSessions, tagOptions } from '../../lib/collections';
import { iso, longDateTime } from '../../lib/dates';
import { collectionPage, topTrail } from '../../lib/seo';

// Every upcoming session ships as a hero, soonest first, with all but the first
// hidden; the same sessions ship again as cards in "more upcoming". The
// `js-next` sweep promotes the next one still standing as time passes, so this
// page does not need rebuilding just because a session has been and gone.
const { upcoming, past } = await splitSessions();

const tags = tagOptions(past);
const types = ['talk', 'debate', 'panel-discussion', 'fireside-chat', 'hands-on'];
const description = 'Live online meetups on Domain-Driven Design, software architecture and design.';
// The archive is what this page is: 100+ recorded sessions, newest first, as an
// ItemList so a crawler gets the list rather than just the page.
const jsonLd = collectionPage(Astro.site, {
  url: new URL('/sessions/', Astro.site).toString(),
  name: 'Online sessions',
  description,
  items: [...upcoming, ...past].map((s) => ({
    name: s.data.title,
    url: new URL(`/sessions/${s.id}/`, Astro.site).toString(),
  })),
  trail: topTrail('Online sessions', '/sessions/'),
});

---

<BaseLayout title="Online sessions — Virtual DDD" description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <h1>Online sessions</h1>

    {upcoming.length > 0 && (
      <section class="hero" aria-label="Next session" data-next-any>
        <p class="eyebrow eyebrow--pink">Next session</p>
        {upcoming.map((session, i) => {
          const f = session.data;
          const sIso = iso(f.datetime);
          return (
            <div class="hero-card js-next" data-test="next-session" data-iso={sIso} hidden={i !== 0}>
              <div class="hero-img">
                {f.featuredImage ? <Image src={f.featuredImage} alt="" width={720} /> : <div class="card-thumb-ph"></div>}
              </div>
              <div class="hero-body">
                <div class="chips">
                  {f.typeOfSession && <span class="chip chip--label chip--primary">{f.typeOfSession}</span>}
                  {f.level?.map((l) => <span class="chip chip--label">{l}</span>)}
                </div>
                <h2><a href={`/sessions/${session.id}/`}>{f.title}</a></h2>
                <p class="hero-date"><time class="js-local" data-format="datetime" datetime={sIso} data-iso={sIso}>{longDateTime(f.datetime)}</time></p>
                {/* The home page has always had this and this page never did,
                    which made the same session feel more imminent there than
                    here. Empty in the HTML like the other one, because a
                    countdown baked at build time is wrong within the minute. */}
                <p class="hero-countdown js-countdown" data-iso={sIso}></p>
                {f.organiser && <p class="hero-host">Hosted by {f.organiser}</p>}
                <div class="hero-cta">
                  {f.humanitix
                    ? <a class="btn btn--accent" href={f.humanitix}>RSVP to attend</a>
                    : <a class="btn btn--accent" href={`/sessions/${session.id}/`}>More info →</a>}
                  {f.humanitix && <a class="btn btn--ghost" href={`/sessions/${session.id}/`}>More info →</a>}
                </div>
                {(f.meet || f.video) && (
                  <div class="hero-live js-live" data-iso={sIso}>
                    <span class="hero-live-label">Starting soon</span>
                    {f.meet && <a class="btn" href={f.meet}>Join Google Meet</a>}
                    {f.video && <a class="btn btn--ghost" href={f.video}>Watch livestream</a>}
                  </div>
                )}
              </div>
            </div>
          );
        })}
        <UpcomingThen sessions={upcoming} />
      </section>
    )}

    {/* Shown when the last announced session has been. Hidden at build time
        whenever the page ships with one, and revealed by the sweep the moment
        that stops being true — which is a clock event, not a build event. */}
    <NoSessionsYet startHidden={upcoming.length > 0} />

    <!-- The ask that fills the space the card grid used to waste: sessions here
         come from members proposing them, so the page says so where somebody is
         already looking at the schedule. The band itself is DiscordCard with
         different words — the home page and the reading list use the same one,
         and a second pink band would be a copy that drifts. -->
    <DiscordCard
      title="Got a topic? That is the session."
      text="There is no panel of experts at the front: members bring what they have learned, and the rest of us ask awkward questions about it. Sessions start as a message in the Discord."
      cta="Propose a session"
    />

    <!-- Between the next session and the archive of past ones, because that is
         where the reader's question changes from "can I come to this" to "what
         else is there", and the answer to the second is: it is a podcast. -->
    <ListenOn show="sessions" class="sessions-listen" />

    <section class="archive">
      <h2>Past sessions</h2>

      <CardFilter
        noun={{ one: 'session', many: 'sessions' }}
        searchLabel="Search sessions"
        searchPlaceholder="Search title, host or tag…"
        facets={[
          { key: 'level', allLabel: 'All levels', label: 'Filter by level', options: ['Beginner', 'Intermediate', 'Advanced'] },
          { key: 'type', allLabel: 'All types', label: 'Filter by type', options: types },
          { key: 'tags', param: 'tag', allLabel: 'All tags', label: 'Filter by tag', options: tags },
        ]}
        pageSize={30}
        emptyMessage="No sessions match your filters."
      >
        <div class="grid-cards">{past.map((s) => <SessionCard session={s} />)}</div>
      </CardFilter>
    </section>
  </div>

  <style>
    .archive h2 { margin-top: var(--space-8); }

    /* The same gap the hero above it leaves, so the card sits in the page's
       rhythm rather than crowding "Past sessions".
       `:global`, because the element belongs to ListenOn and this file's scope
       attribute is not on it. Without it Astro compiles the selector against a
       cid the element does not carry, the rule matches nothing, and the only
       symptom is 32px of gap where the hero above leaves 64. That is what this
       shipped as until somebody measured it rather than looking at it. */
    :global(.sessions-listen) { margin-bottom: var(--space-16); }

    /* Upcoming hero.
       `.hero-card` below has a twin: `.none-card` in NoSessionsYet.astro, which
       is the same block with no session in it and has to look like this one.
       They are deliberately not shared. The split is driven by the viewport
       here, where this is always the full page width, and by a container query
       there, because that component also sits in the home page's narrower
       column. Retune the proportions in one and the other will not follow. */
    .hero { margin-bottom: var(--space-16); }
    .hero-card { display: grid; grid-template-columns: 1fr; background: var(--color-surface); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
    .hero-img { aspect-ratio: 16 / 9; background: var(--color-surface); }
    .hero-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .hero-body { padding: var(--space-8); }
    .hero-body .chips { margin-bottom: var(--space-3); }
    .hero-body h2 { font-size: var(--text-3xl); margin: 0 0 var(--space-3); }
    .hero-body h2 a { color: var(--color-text); }
    .hero-date { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); margin: 0 0 var(--space-1); }
    .hero-countdown { font-family: var(--font-heading); font-weight: 700; color: var(--color-primary); margin: 0 0 var(--space-2); font-variant-numeric: tabular-nums; }
    .hero-host { color: var(--color-text-muted); margin: 0 0 var(--space-6); }
    .hero-cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }
    .hero-live { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-4); }
    .hero-live-label { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--text-sm); color: var(--color-primary); }

    @media (min-width: 800px) {
      .hero-card { grid-template-columns: 1.1fr 1fr; }
      .hero-img { aspect-ratio: auto; }
    }

    .grid-cards { --card-min: 16.25rem; }
  </style>

</BaseLayout>
