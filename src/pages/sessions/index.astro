---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SessionCard from '../../components/SessionCard.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('sessions');
const now = Date.now();
const upcoming = all
  .filter((s) => s.data.status === 'Published' && +new Date(s.data.datetime) > now)
  .sort((a, b) => +new Date(a.data.datetime) - +new Date(b.data.datetime));
const past = all
  .filter((s) => !(s.data.status === 'Published' && +new Date(s.data.datetime) > now))
  .sort((a, b) => +new Date(b.data.datetime) - +new Date(a.data.datetime));
---

<BaseLayout
  title="Online sessions — Virtual DDD"
  description="Live online meetups on Domain-Driven Design, software architecture and design."
>
  <div class="wrap">
    <h1>Online sessions</h1>
    <p class="lead">
      Live online meetups on Domain-Driven Design, software architecture &amp; design —
      {upcoming.length + past.length} sessions and counting.
    </p>

    {upcoming.length > 0 && (
      <section>
        <h2>Upcoming</h2>
        <div class="grid">{upcoming.map((s) => <SessionCard session={s} />)}</div>
      </section>
    )}

    <section>
      <h2>{upcoming.length ? 'Past sessions' : 'All sessions'}</h2>
      <div class="grid">{past.map((s) => <SessionCard session={s} />)}</div>
    </section>
  </div>

  <style>
    .lead { color: var(--color-text-muted); font-size: var(--text-lg); max-width: 42rem; margin-bottom: var(--space-12); }
    section { margin-bottom: var(--space-16); }
    section h2 { margin-bottom: var(--space-6); }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--space-6); }
  </style>
</BaseLayout>
