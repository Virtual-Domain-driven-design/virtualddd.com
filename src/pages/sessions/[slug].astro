---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SideExtras from '../../components/SideExtras.astro';
import DiscussedHeuristics from '../../components/DiscussedHeuristics.astro';
import PersonRow from '../../components/PersonRow.astro';
import PrevNext from '../../components/PrevNext.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { youtubeEmbed } from '../../lib/embeds';
import { excerpt } from '../../lib/excerpt';
import { sessionJsonLd, pageTitle, trail, type PersonInput } from '../../lib/seo';
import { socialCard } from '../../lib/social-card';
import { iso as toIso, longDate } from '../../lib/dates';
import { profileLinks, samePerson } from '../../lib/people';
import {
  byDateAsc, guestsById, heuristicsById, isUpcoming as sessionIsUpcoming,
  resolveRefs, sessionTeasers, siblings,
} from '../../lib/collections';

export async function getStaticPaths() {
  const sessions = await getCollection('sessions');
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session, sessions } }));
}

const { session, sessions } = Astro.props;
const { Content } = await render(session);
const d = session.data;

const discussed = resolveRefs(d.curatedHeuristics, await heuristicsById());

// Host — match the organiser name to the organisers collection for the rich card.
const organisers = await getCollection('organisers');
const orgByName = new Map(organisers.map((o) => [o.data.name.trim().toLowerCase(), o]));
const host = d.organiser ? orgByName.get(d.organiser.trim().toLowerCase()) : undefined;

// Guests — the speakers and panellists. Someone who both organises and speaks
// has a row in each database on purpose (see docs/content-model.md), so link a
// guest to
// their organiser page and fall back to the portrait and role already held
// there rather than asking for the same thing twice.
const guests = resolveRefs(d.guests, await guestsById())
  .map((g) => {
    const also = organisers.find((o) => samePerson(o.data.name, g.data.name));
    const links = profileLinks(g.data);
    return {
      name: g.data.name,
      bio: g.data.bio,
      photo: g.data.photo ?? also?.data.photo,
      href: also ? `/organisers/${also.id}/` : undefined,
      links: links.length ? links : profileLinks(also?.data ?? {}),
    };
  })
  // The host is already introduced below; a guest row for the same person
  // would say it twice.
  .filter((g) => !d.organiser || !samePerson(g.name, d.organiser));

// Two levels, deliberately. A guest we only know the name of is a credit under
// the title — one line, where a reader looks for who is on it. A guest with a
// bio (and a portrait, when there is one) is worth a block below the
// description, where someone who has just read the abstract is ready to be
// told who is giving it. Write a Bio in Notion and the block appears on the
// next sync; until then nothing is lost, because the credit names them and the
// structured data still says who performed.
const guestsIntroduced = guests.some((g) => g.bio);

const hostLinks = profileLinks(host?.data ?? {});
// One Person node per human on the session, guests first: they are what the
// page is about, and the organiser hosts.
const performers: PersonInput[] = [
  ...guests.map((g) => ({
    name: g.name, bio: g.bio,
    url: g.links.find((l) => l.label === 'Website')?.href,
    sameAs: g.links.map((l) => l.href),
    page: g.href ? new URL(g.href, Astro.site).toString() : undefined,
  })),
  ...(d.organiser
    ? [{
        name: host?.data.name ?? d.organiser,
        role: host?.data.role,
        url: host?.data.website,
        sameAs: hostLinks.map((l) => l.href),
        page: host ? new URL(`/organisers/${host.id}/`, Astro.site).toString() : undefined,
      }]
    : []),
  ...d.coOrganisers.map((name) => ({ name })),
];

const videoEmbed = youtubeEmbed(d.video);

const { prev, next } = siblings([...sessions].sort(byDateAsc), session.id);
const latest = sessionTeasers(sessions, session.id);

const isUpcoming = sessionIsUpcoming(session);
const iso = toIso(d.datetime);
const dateStr = longDate(d.datetime);

// SEO. Sessions carried no meta description at all before; fall back to the
// opening of the body so every page says something useful in results.
const url = new URL(`/sessions/${session.id}/`, Astro.site).toString();
const image = d.featuredImage;
const description =
  d.seoMetadescription ?? excerpt(session.body ?? '', `${d.title} — a Virtual DDD online session.`, 155);
const jsonLd = sessionJsonLd(Astro.site, session, {
  url,
  image: image ? await socialCard(Astro.site, image) : undefined,
  isUpcoming,
  performers,
  trail: trail('sessions', d.title, `/sessions/${session.id}/`),
});
---

<BaseLayout
  title={pageTitle(d.seoTitle ?? d.title)}
  description={description}
  image={image}
  ogType="article"
  jsonLd={jsonLd}
  markdown
>
  <article class="session detail wrap">
    <div class="detail-head">
      <p class="detail-back" data-pagefind-ignore><a href="/sessions/">← All sessions</a></p>
      <div class="chips">
        {d.typeOfSession && <span class="chip chip--label chip--primary">{d.typeOfSession}</span>}
        {d.level?.map((l) => <span class="chip chip--label">{l}</span>)}
      </div>
      <h1>{d.title}</h1>
      {guests.length > 0 && (
        <p class="guest-credit" data-test="guest-credit">
          {guests.length === 1 ? 'Guest' : 'Guests'}: <strong>{guests.map((g) => g.name).join(', ')}</strong>
        </p>
      )}

      {videoEmbed ? (
        <div class="video">
          <iframe
            src={videoEmbed}
            title={d.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      ) : d.featuredImage ? (
        <Image class="media-hero" src={d.featuredImage} alt={d.title} width={920} />
      ) : null}

      {d.podcastPlayer && (
        <iframe class="podcast" src={d.podcastPlayer} title="Podcast player" loading="lazy" width="100%" height="170"></iframe>
      )}
    </div>

    <aside class="detail-side">
      <div class="side-card">
        <p class="side-date"><time class="js-local" data-format="datetime" datetime={iso} data-iso={iso}>{dateStr}</time></p>
        {d.organiser && <p class="side-org">Hosted by <strong>{d.organiser}</strong></p>}
        {isUpcoming && (d.humanitix || d.meet) && (
          <a class="btn btn--accent side-rsvp" href={d.humanitix ?? d.meet}>RSVP to attend</a>
        )}
        {isUpcoming && (
          <a class="btn btn--ghost side-rsvp" data-test="add-to-calendar" href={`/sessions/${session.id}/event.ics`}>Add to calendar</a>
        )}
        {(d.video || d.miro) && (
          <p class="side-links">
            {d.video && <a href={d.video}>Watch on YouTube ↗</a>}
            {d.miro && <a href={d.miro}>Miro board ↗</a>}
          </p>
        )}
      </div>

      {d.tags.length > 0 && (
        <div class="side-block">
          <h2>Tags</h2>
          <div class="chips">{d.tags.map((t) => <span class="chip chip--outline">{t}</span>)}</div>
        </div>
      )}

      <SideExtras latest={latest} latestLabel="Latest sessions" latestAllHref="/sessions/" />
    </aside>

    <div class="detail-body">
      <div class="prose-body"><Content /></div>

      {guestsIntroduced && (
        <section class="people-card">
          <h2>{guests.length === 1 ? 'Guest' : 'Guests'}</h2>
          <ul class="people">
            {guests.map((g) => (
              <li data-test="guest">
                <PersonRow name={g.name} bio={g.bio} photo={g.photo} href={g.href} links={g.links} stacked />
              </li>
            ))}
          </ul>
        </section>
      )}

      {(host || d.organiser) && (
        <section class="people-card">
          <h2>About the host</h2>
          <PersonRow
            name={host?.data.name ?? d.organiser!}
            role={host?.data.role}
            photo={host?.data.photo}
            href={host ? `/organisers/${host.id}/` : undefined}
            links={hostLinks}
          />
          {d.coOrganisers.length > 0 && <p class="org-co">With {d.coOrganisers.join(', ')}</p>}
        </section>
      )}

      <DiscussedHeuristics heuristics={discussed} />

      <PrevNext
        noun="session"
        prev={prev && { href: `/sessions/${prev.id}/`, title: prev.data.title }}
        next={next && { href: `/sessions/${next.id}/`, title: next.data.title }}
      />
    </div>
  </article>

  <style>
    .detail-head .chips { margin-bottom: var(--space-3); }
    /* Layout, media and prose come from patterns.css (.detail, .video, .prose-body). */
    .detail-head h1 { margin-bottom: var(--space-3); }
    /* Who is on it, directly under the title — the question a reader arrives with. */
    .guest-credit { color: var(--color-text-muted); margin: 0 0 var(--space-6); }
    .guest-credit strong { color: var(--color-text); font-family: var(--font-heading); font-weight: 600; }

    /* Sidebar */
    .side-card { background: var(--color-surface); border-radius: var(--radius); padding: var(--space-6); }
    .side-date { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); margin: 0 0 var(--space-1); }
    .side-org { color: var(--color-text-muted); margin: 0 0 var(--space-4); }
    .side-org strong { color: var(--color-accent-dark); }
    .side-rsvp { display: flex; justify-content: center; margin-bottom: var(--space-4); }
    .side-links { display: flex; flex-direction: column; gap: var(--space-1); margin: 0; font-size: var(--text-sm); }
    .side-block { margin-top: var(--space-6); }
    .side-block h2 { font-size: var(--text-base); text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); margin: 0 0 var(--space-3); }
    .side-block .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }

    /* Guests and about-the-host panels — the people are a PersonRow each. */
    .people-card { background: var(--color-surface); border-radius: var(--radius); padding: var(--space-6); margin: var(--space-8) 0; }
    .people-card h2 { margin-top: 0; }
    .people { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-6); }
    /* With the bio running full width, one guest ends where the next begins
       and the gap alone stops saying which paragraph belongs to whom. */
    .people li + li { border-top: 1px solid var(--color-border); padding-top: var(--space-6); }
    .org-co { color: var(--color-text-muted); font-size: var(--text-sm); margin: var(--space-4) 0 0; }
  </style>
</BaseLayout>
