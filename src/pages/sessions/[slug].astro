---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SideExtras from '../../components/SideExtras.astro';
import DiscussedHeuristics from '../../components/DiscussedHeuristics.astro';
import PrevNext from '../../components/PrevNext.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { youtubeEmbed } from '../../lib/embeds';
import { excerpt } from '../../lib/excerpt';
import { sessionJsonLd, socialCard } from '../../lib/seo';
import { iso as toIso, longDate } from '../../lib/dates';
import {
  byDateAsc, heuristicsById, isUpcoming as sessionIsUpcoming,
  resolveHeuristics, sessionTeasers, siblings,
} from '../../lib/collections';

export async function getStaticPaths() {
  const sessions = await getCollection('sessions');
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session, sessions } }));
}

const { session, sessions } = Astro.props;
const { Content } = await render(session);
const d = session.data;

const discussed = resolveHeuristics(d.curatedHeuristics, await heuristicsById());

// Host — match the organiser name to the organisers collection for the rich card.
const organisers = await getCollection('organisers');
const orgByName = new Map(organisers.map((o) => [o.data.name.trim().toLowerCase(), o]));
const host = d.organiser ? orgByName.get(d.organiser.trim().toLowerCase()) : undefined;

const videoEmbed = youtubeEmbed(d.video);

const { prev, next } = siblings([...sessions].sort(byDateAsc), session.id);
const latest = sessionTeasers(sessions, session.id);

const isUpcoming = sessionIsUpcoming(session);
const iso = toIso(d.datetime);
const dateStr = longDate(d.datetime);

// SEO. Sessions carried no meta description at all before; fall back to the
// opening of the body so every page says something useful in results.
const url = new URL(`/sessions/${session.id}/`, Astro.site).toString();
const image = d.featuredImage;
const description =
  d.seoMetadescription ?? excerpt(session.body ?? '', `${d.title} — a Virtual DDD online session.`, 155);
const jsonLd = sessionJsonLd(Astro.site, session, {
  url,
  image: image ? await socialCard(Astro.site, image) : undefined,
  isUpcoming,
});
---

<BaseLayout
  title={`${d.seoTitle ?? d.title} — Virtual DDD`}
  description={description}
  image={image}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="session detail wrap">
    <div class="detail-head">
      <p class="detail-back"><a href="/sessions/">← All sessions</a></p>
      <div class="chips">
        {d.typeOfSession && <span class="chip chip--label chip--primary">{d.typeOfSession}</span>}
        {d.level?.map((l) => <span class="chip chip--label">{l}</span>)}
      </div>
      <h1>{d.title}</h1>

      {videoEmbed ? (
        <div class="video">
          <iframe
            src={videoEmbed}
            title={d.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      ) : d.featuredImage ? (
        <Image class="media-hero" src={d.featuredImage} alt={d.title} width={920} />
      ) : null}

      {d.podcastPlayer && (
        <iframe class="podcast" src={d.podcastPlayer} title="Podcast player" loading="lazy" width="100%" height="170"></iframe>
      )}
    </div>

    <aside class="detail-side">
      <div class="side-card">
        <p class="side-date"><time class="js-local" data-format="datetime" datetime={iso} data-iso={iso}>{dateStr}</time></p>
        {d.organiser && <p class="side-org">Hosted by <strong>{d.organiser}</strong></p>}
        {isUpcoming && (d.humantix || d.meet) && (
          <a class="btn btn--accent side-rsvp" href={d.humantix ?? d.meet}>RSVP to attend</a>
        )}
        {isUpcoming && (
          <a class="btn btn--ghost side-rsvp" data-test="add-to-calendar" href={`/sessions/${session.id}/event.ics`}>Add to calendar</a>
        )}
        {(d.video || d.miro) && (
          <p class="side-links">
            {d.video && <a href={d.video}>Watch on YouTube ↗</a>}
            {d.miro && <a href={d.miro}>Miro board ↗</a>}
          </p>
        )}
      </div>

      {d.tags.length > 0 && (
        <div class="side-block">
          <h3>Tags</h3>
          <div class="chips">{d.tags.map((t) => <span class="chip chip--outline">{t}</span>)}</div>
        </div>
      )}

      <SideExtras latest={latest} latestLabel="Latest sessions" latestAllHref="/sessions/" />
    </aside>

    <div class="detail-body">
      <div class="prose-body"><Content /></div>

      {(host || d.organiser) && (
        <section class="host-card">
          <h2>About the host</h2>
          <div class="org">
            {host?.data.photo && <Image class="org-photo" src={host.data.photo} alt={host.data.name} width={180} />}
            <div class="org-info">
              <p class="org-name">{host?.data.name ?? d.organiser}</p>
              {host?.data.role && <p class="org-role">{host.data.role}</p>}
              {host && (host.data.website || host.data.linkedin) && (
                <p class="org-links">
                  {host.data.website && <a href={host.data.website}>Website</a>}
                  {host.data.linkedin && <a href={host.data.linkedin}>LinkedIn</a>}
                </p>
              )}
            </div>
          </div>
          {d.coOrganisers.length > 0 && <p class="org-co">With {d.coOrganisers.join(', ')}</p>}
        </section>
      )}

      <DiscussedHeuristics heuristics={discussed} />

      <PrevNext
        noun="session"
        prev={prev && { href: `/sessions/${prev.id}/`, title: prev.data.title }}
        next={next && { href: `/sessions/${next.id}/`, title: next.data.title }}
      />
    </div>
  </article>

  <style>
    .detail-head .chips { margin-bottom: var(--space-3); }
    /* Layout, media and prose come from patterns.css (.detail, .video, .prose-body). */
    .detail-head h1 { margin-bottom: var(--space-6); }

    /* Sidebar */
    .side-card { background: var(--color-surface); border-radius: var(--radius); padding: var(--space-6); }
    .side-date { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); margin: 0 0 var(--space-1); }
    .side-org { color: var(--color-text-muted); margin: 0 0 var(--space-4); }
    .side-org strong { color: var(--color-accent-dark); }
    .side-rsvp { display: flex; justify-content: center; margin-bottom: var(--space-4); }
    .side-links { display: flex; flex-direction: column; gap: var(--space-1); margin: 0; font-size: var(--text-sm); }
    .side-block { margin-top: var(--space-6); }
    .side-block h3 { font-size: var(--text-base); text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); margin: 0 0 var(--space-3); }
    .side-block .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .heur-list { margin: 0; padding-left: var(--space-4); font-size: var(--text-sm); }
    .heur-list li { margin-bottom: var(--space-2); }

    /* About-the-host panel */
    .host-card { background: var(--color-surface); border-radius: var(--radius); padding: var(--space-6); margin: var(--space-8) 0; }
    .host-card h2 { margin-top: 0; }
    .org { display: flex; gap: var(--space-4); align-items: center; }
    .org-photo { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; flex: none; box-shadow: var(--shadow); }
    .org-name { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); margin: 0; }
    .org-role { color: var(--color-accent-dark); margin: 0 0 var(--space-2); }
    .org-links { display: flex; gap: var(--space-4); margin: 0; font-size: var(--text-sm); }
    .org-co { color: var(--color-text-muted); font-size: var(--text-sm); margin: var(--space-4) 0 0; }
  </style>
</BaseLayout>
