---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const sessions = await getCollection('sessions');
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session, sessions } }));
}

const { session, sessions } = Astro.props;
const { Content } = await render(session);
const d = session.data;

// Discussed heuristics — resolve defensively (skip any not synced/published).
const heuristics = await getCollection('heuristics');
const heurById = new Map(heuristics.map((h) => [h.id, h]));
const discussed = d.curatedHeuristics.map((r) => heurById.get(r.id)).filter(Boolean);

// Host — match the organiser name to the organisers collection for the rich card.
const organisers = await getCollection('organisers');
const orgByName = new Map(organisers.map((o) => [o.data.name.trim().toLowerCase(), o]));
const host = d.organiser ? orgByName.get(d.organiser.trim().toLowerCase()) : undefined;

// Normalise a YouTube URL (embed / youtu.be / watch / live) to a nocookie embed.
function youtubeEmbed(url?: string): string | null {
  if (!url) return null;
  let m: RegExpMatchArray | null;
  let id: string | undefined;
  if ((m = url.match(/youtube\.com\/embed\/([^?/&]+)/))) id = m[1];
  else if ((m = url.match(/youtu\.be\/([^?/&]+)/))) id = m[1];
  else if ((m = url.match(/youtube\.com\/live\/([^?/&]+)/))) id = m[1];
  else if ((m = url.match(/[?&]v=([^&]+)/))) id = m[1];
  return id ? `https://www.youtube-nocookie.com/embed/${id}` : null;
}
const videoEmbed = youtubeEmbed(d.video) ?? (d.video?.includes('/embed/') ? d.video : null);

// Prev / next by date.
const ordered = [...sessions].sort((a, b) => +new Date(a.data.datetime) - +new Date(b.data.datetime));
const idx = ordered.findIndex((s) => s.id === session.id);
const prev = ordered[idx - 1];
const next = ordered[idx + 1];

const isUpcoming = d.status === 'Published' && new Date(d.datetime) > new Date();
const dateStr = new Date(d.datetime).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${d.seoTitle ?? d.title} — Virtual DDD`} description={d.seoMetadescription}>
  <article class="session wrap">
    <div class="s-head">
      <p class="back"><a href="/sessions/">← All sessions</a></p>
      <div class="badges">
        {d.typeOfSession && <span class="badge badge--type">{d.typeOfSession}</span>}
        {d.level?.map((l) => <span class="badge">{l}</span>)}
      </div>
      <h1>{d.title}</h1>

      {videoEmbed ? (
        <div class="video">
          <iframe
            src={videoEmbed}
            title={d.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      ) : d.featuredImage ? (
        <Image class="hero" src={d.featuredImage} alt={d.title} width={920} />
      ) : null}

      {d.podcastPlayer && (
        <iframe class="podcast" src={d.podcastPlayer} title="Podcast player" loading="lazy" width="100%" height="170"></iframe>
      )}
    </div>

    <aside class="s-side">
      <div class="side-card">
        <p class="side-date">{dateStr}</p>
        {d.organiser && <p class="side-org">Hosted by <strong>{d.organiser}</strong></p>}
        {isUpcoming && (d.humantix || d.meet) && (
          <a class="btn btn--accent side-rsvp" href={d.humantix ?? d.meet}>RSVP to attend</a>
        )}
        {(d.video || d.miro) && (
          <p class="side-links">
            {d.video && <a href={d.video}>Watch on YouTube ↗</a>}
            {d.miro && <a href={d.miro}>Miro board ↗</a>}
          </p>
        )}
      </div>

      {d.tags.length > 0 && (
        <div class="side-block">
          <h3>Tags</h3>
          <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </div>
      )}

      {discussed.length > 0 && (
        <div class="side-block">
          <h3>Discussed heuristics</h3>
          <ul class="heur-list">{discussed.map((h) => <li>{h!.data.title}</li>)}</ul>
        </div>
      )}
    </aside>

    <div class="s-body">
      <div class="body"><Content /></div>

      {(host || d.organiser) && (
        <section class="card organiser">
          <h2>About the host</h2>
          <div class="org">
            {host?.data.photo && <Image class="org-photo" src={host.data.photo} alt={host.data.name} width={180} />}
            <div class="org-info">
              <p class="org-name">{host?.data.name ?? d.organiser}</p>
              {host?.data.role && <p class="org-role">{host.data.role}</p>}
              {host && (host.data.website || host.data.linkedin || host.data.twitter) && (
                <p class="org-links">
                  {host.data.website && <a href={host.data.website}>Website</a>}
                  {host.data.linkedin && <a href={host.data.linkedin}>LinkedIn</a>}
                  {host.data.twitter && <a href={host.data.twitter}>Twitter</a>}
                </p>
              )}
            </div>
          </div>
          {d.coOrganisers.length > 0 && <p class="org-co">With {d.coOrganisers.join(', ')}</p>}
        </section>
      )}

      <nav class="prevnext">
        {prev ? <a href={`/sessions/${prev.id}/`}>← {prev.data.title}</a> : <span />}
        {next && <a class="pn-next" href={`/sessions/${next.id}/`}>{next.data.title} →</a>}
      </nav>
    </div>
  </article>

  <style>
    .session { display: grid; grid-template-columns: 1fr; gap: var(--space-8); }
    .back { font-size: var(--text-sm); margin-bottom: var(--space-3); }
    .badges { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-3); }
    .s-head h1 { margin-bottom: var(--space-6); }

    .video { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); background: #000; }
    .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .hero { width: 100%; border-radius: var(--radius); box-shadow: var(--shadow); }
    .podcast { display: block; width: 100%; border: 0; border-radius: var(--radius-sm); margin-top: var(--space-4); }

    /* Sidebar */
    .side-card { background: var(--color-surface); border-radius: var(--radius); padding: var(--space-6); }
    .side-date { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); margin: 0 0 var(--space-1); }
    .side-org { color: var(--color-text-muted); margin: 0 0 var(--space-4); }
    .side-org strong { color: var(--color-accent-dark); }
    .side-rsvp { display: flex; justify-content: center; margin-bottom: var(--space-4); }
    .side-links { display: flex; flex-direction: column; gap: var(--space-1); margin: 0; font-size: var(--text-sm); }
    .side-block { margin-top: var(--space-6); }
    .side-block h3 { font-size: var(--text-base); text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); margin: 0 0 var(--space-3); }
    .side-block .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .heur-list { margin: 0; padding-left: var(--space-4); font-size: var(--text-sm); }
    .heur-list li { margin-bottom: var(--space-2); }

    /* Body */
    .body :global(h2) { margin-top: var(--space-8); }
    .body :global(img) { border-radius: var(--radius-sm); margin: var(--space-4) 0; }
    .card { background: var(--color-surface); border-radius: var(--radius); padding: var(--space-6); margin: var(--space-8) 0; }
    .card h2 { margin-top: 0; }
    .org { display: flex; gap: var(--space-4); align-items: center; }
    .org-photo { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; flex: none; box-shadow: var(--shadow); }
    .org-name { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); margin: 0; }
    .org-role { color: var(--color-accent-dark); margin: 0 0 var(--space-2); }
    .org-links { display: flex; gap: var(--space-4); margin: 0; font-size: var(--text-sm); }
    .org-co { color: var(--color-text-muted); font-size: var(--text-sm); margin: var(--space-4) 0 0; }

    .prevnext { display: flex; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-12); padding-top: var(--space-6); border-top: 1px solid var(--color-border); font-family: var(--font-heading); font-weight: 600; }
    .prevnext .pn-next { margin-left: auto; text-align: right; }

    @media (min-width: 900px) {
      .session {
        grid-template-columns: minmax(0, 1fr) 19rem;
        grid-template-areas: "head side" "body side";
        grid-template-rows: auto 1fr;
        column-gap: var(--space-12);
        row-gap: var(--space-6);
        align-items: start;
      }
      .s-head { grid-area: head; }
      .s-body { grid-area: body; }
      .s-side { grid-area: side; position: sticky; top: 5.5rem; align-self: start; }
    }
  </style>
</BaseLayout>
