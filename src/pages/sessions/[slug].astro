---
// PLACEHOLDER route — proves session content renders. Real design is the
// Phase 5 section-by-section loop; do not treat this markup as the design.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const sessions = await getCollection('sessions');
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const { Content } = await render(session);
const d = session.data;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.seoTitle ?? d.title} — Virtual DDD</title>
    {d.seoMetadescription && <meta name="description" content={d.seoMetadescription} />}
  </head>
  <body>
    <main style="max-width: 42rem; margin: 2rem auto; padding: 0 1rem;">
      <p><a href="/sessions/">← All sessions</a></p>
      <h1>{d.title}</h1>
      <p>{new Date(d.datetime).toLocaleDateString()} · {d.typeOfSession}{d.organiser ? ` · ${d.organiser}` : ''}</p>
      {d.featuredImage && <Image src={d.featuredImage} alt={d.title} width={800} style="max-width:100%;height:auto;" />}
      {d.video && <p><a href={d.video}>▶ Watch the recording</a></p>}
      <article><Content /></article>
    </main>
  </body>
</html>
