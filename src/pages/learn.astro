---
import BaseLayout from '../layouts/BaseLayout.astro';
import JourneyBoard from '../components/JourneyBoard.astro';
import NotationKey from '../components/NotationKey.astro';
import { getCollection } from 'astro:content';
import { collectionPage, topTrail, pageTitle } from '../lib/seo';

// The guided path, when there is one. Only stages that pass the publish gate
// produce files, so an unfinished journey simply does not render and this page
// stays the hub it already is. `JourneyBoard` renders nothing at all when the
// list is empty, which is why there is no guard around it here.
const stages = (await getCollection('learningJourney'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

/**
 * The Learn DDD hub.
 *
 * Deliberately small. It exists so the header can carry one slot instead of one
 * per resource type, and so /reading-list/, /ddd-crew/ and later /videos/ have a
 * parent to sit under. The guided journey lands here when it is written; until
 * then this page points at what already exists rather than promising a path that
 * does not.
 *
 * No card images: the reading list has covers, ddd-crew has hero images and the
 * heuristics have none, so three cards would be inconsistent. Text cards say the
 * same thing without inventing artwork.
 */
const DISCORD = 'https://discord.gg/tRJkcsFDKN';

const sections = [
  {
    href: '/reading-list/',
    title: 'Reading list',
    text: 'Books, papers and free PDFs we would defend, each with one line on why it is worth your evening. The free ones come first.',
    more: 'Browse the reading list',
  },
  {
    href: '/ddd-crew/',
    title: 'ddd-crew tools',
    text: 'Canvases, modelling processes and reference guides from the ddd-crew, republished here with attribution under CC BY-SA so they are easy to browse.',
    more: 'Browse the tools',
  },
  {
    href: '/heuristics/',
    title: 'Heuristics',
    text: 'Rules of thumb pulled out of real sessions. Not theory: what practitioners actually decided, and when it held.',
    more: 'Browse the heuristics',
  },
];

const description =
  'Free resources for learning Domain-Driven Design, curated by the Virtual DDD community: ' +
  'a reading list, the ddd-crew tools, and heuristics taken from real sessions.';

const jsonLd = collectionPage(Astro.site, {
  url: new URL('/learn/', Astro.site).toString(),
  name: 'Learn DDD',
  description,
  items: sections.map((s) => ({
    name: s.title,
    url: new URL(s.href, Astro.site).toString(),
  })),
  trail: topTrail('Learn DDD', '/learn/'),
});
---

<BaseLayout title={pageTitle('Learn DDD', { brand: true })} description={description} jsonLd={jsonLd}>
  {/* No hero band. /reading-list/ opens the same way and for the same reason:
      the h1 lives in the cyan panel, which fills the half of the screen a band
      leaves empty and closes without a rule between the promise and the page.

      The panel leads, in the source and on the screen, so the h1 is never
      preceded by an h2 and a narrow screen stacks them in the order they are
      meant to be read. */}
  <section class="wrap learn-intro">
    <div class="li-about panel-cyan">
      <h1>Learn Domain-Driven Design</h1>
      <p>
        All of it free, and none of it behind a signup.
      </p>
      <p>
        The path below is where we would start somebody who has just been told to go
        and look at Domain-Driven Design. It is what we would say to them in person.
      </p>
      <p>
        Tell us what is missing from it, or which step you got stuck on.
      </p>
      <a class="btn btn--ink" href={DISCORD}>Join our Discord &rarr;</a>
    </div>

    {stages.length > 0
      ? <NotationKey />
      : (
        <p class="hero-note">
          A guided path for someone completely new to this is being written. Until it is
          here, start wherever your problem is.
        </p>
      )}
  </section>

  <JourneyBoard stages={stages} />

  <section class="wrap" data-pagefind-body>
    <div class="section-head">
      <h2>The whole library</h2>
      {/* His words, moved rather than rewritten: "three ways in" was written for
          these three cards, and above a single path it read as a promise the
          page did not keep. */}
      <p class="library-note">
        Three ways in, depending on whether you want something to read, something to run
        in a session, or what people decided when they tried.
      </p>
    </div>
    <ul class="learn-grid">
      {sections.map((s) => (
        <li>
          <a class="card learn-card" href={s.href}>
            <div class="card-body">
              <h2 class="card-title">{s.title}</h2>
              <p class="card-excerpt">{s.text}</p>
              <span class="card-more">{s.more} &rarr;</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  /* Same two-column opening as /reading-list/: source order puts the panel
     first so the h1 leads, the grid puts it on the right on a wide screen. */
  .learn-intro { display: grid; gap: var(--space-8); margin-bottom: var(--space-16); }
  @media (min-width: 900px) {
    .learn-intro { grid-template-columns: 1fr 1fr; align-items: start; }
  }
  .li-about h1 { margin: 0 0 var(--space-4); font-size: var(--text-3xl); }
  .li-about p { margin: 0 0 var(--space-4); }
  .library-note { color: var(--color-text-muted); font-size: var(--text-sm); margin: 0; max-width: 60ch; }

  .learn-grid { list-style: none; margin: 0 0 var(--space-16); padding: 0; display: grid; gap: var(--space-6); }
  @media (min-width: 48rem) { .learn-grid { grid-template-columns: repeat(3, 1fr); } }

  /* The whole card is the link, so it needs to fill its grid cell and push the
     read-more line to the bottom however long the description runs. */
  /* `p a, li a` in global.css underlines inline prose links, and a card that IS
     an anchor inside an <li> matches it, so every word in the card inherits an
     underline. That rule is not meant for this. */
  .learn-card, .learn-card:hover { text-decoration: none; }
  .learn-card { height: 100%; padding: var(--space-6); }
  .learn-card .card-body { display: flex; flex-direction: column; flex: 1; }
  .learn-card .card-title { margin: 0 0 var(--space-3); }
  .card-excerpt { color: var(--color-text-muted); margin: 0; line-height: 1.6; }
</style>
