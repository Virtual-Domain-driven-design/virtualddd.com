---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrganiserCard from '../../components/OrganiserCard.astro';
import TeaserCard from '../../components/TeaserCard.astro';
import { getCollection } from 'astro:content';
import { tagOptions } from '../../lib/collections';
import { iso, shortDate } from '../../lib/dates';
import { excerpt } from '../../lib/excerpt';

const stories = (await getCollection('stories')).sort(
  (a, b) => (b.data.episode ?? 0) - (a.data.episode ?? 0),
);

// The three stable hosts of the series (fixed order).
const organisers = await getCollection('organisers');
const byId = new Map(organisers.map((o) => [o.id, o]));
const hosts = ['andrea-magnorsky', 'andrew-harmel-law', 'kenny-baas-schwegler']
  .map((id) => byId.get(id))
  .filter(Boolean) as typeof organisers;

const tags = tagOptions(stories);
---

<BaseLayout
  title="Facilitating Stories — Virtual DDD"
  description="Real-world stories on facilitating software architecture and design — practical experiences from the community."
>
  <!-- Intro: hosts (rotating) + explanation card, two columns like the home page -->
  <section class="wrap">
    <div class="stories-intro">
      <div class="si-hosts">
        <p class="eyebrow eyebrow--cyan">Your hosts</p>
        <div class="solo-carousel">
          <div class="solo">
            <div class="solo-track">
              {hosts.map((o) => <div class="solo-slide"><OrganiserCard organiser={o} /></div>)}
            </div>
          </div>
          <div class="solo-dots">
            {hosts.map((_, i) => <button type="button" data-i={i} aria-label={`Host ${i + 1}`}></button>)}
          </div>
        </div>
      </div>

      <aside class="si-about panel-cyan">
        <p class="eyebrow eyebrow--dark">Facilitating Stories</p>
        <h1>Stories on Facilitating Software Design &amp; Architecture</h1>
        <p>
          Regardless of the architectural approach — from traditional enterprise to more hands-on,
          emergent methods — teams face similar obstacles when building effective systems. The core
          challenge remains how to build software that truly works and enables a smooth flow of delivery.
        </p>
        <p>
          So we started this series: real-world experiences from our community, sharing practical stories
          about the approaches that have delivered results — moving beyond the theoretical and into the
          practical.
        </p>
        <a class="btn btn--accent si-btn" href="/ai-usage-on-this-site/">Read more on our AI usage →</a>
      </aside>
    </div>
  </section>

  <!-- Story archive -->
  <section class="archive">
    <div class="wrap">
      <div class="archive-head">
        <p class="eyebrow eyebrow--cyan">All stories</p>
        <span class="result-count" id="count" data-test="result-count"></span>
      </div>

      <div class="filters">
        <input type="search" id="q" data-test="filter-search" placeholder="Search title, author or tag…" aria-label="Search stories" />
        <select id="f-tag" data-test="filter-tag" aria-label="Filter by tag">
          <option value="">All tags</option>
          {tags.map((t) => <option value={t}>{t}</option>)}
        </select>
        <button id="f-reset" class="filter-reset" data-test="filter-reset" type="button">Reset</button>
      </div>

      <div class="grid-cards story-list" id="cards">
        {stories.map((s) => {
          const d = s.data;
          const authors = d.authors.slice(0, 3).join(', ') + (d.authors.length > 3 ? ' & more' : '');
          return (
            <TeaserCard
              class="story-card"
              href={`/facilitating-archdes/${s.id}/`}
              title={d.title}
              img={d.featuredImage ?? d.featuredImageSquared}
              imgWidth={720}
              badge={d.episode != null ? `Ep ${d.episode}` : undefined}
              iso={d.publishedDate ? iso(d.publishedDate) : undefined}
              dateFallback={d.publishedDate ? shortDate(d.publishedDate) : undefined}
              accentMeta
              sub={d.authors.length > 0 ? `by ${authors}` : undefined}
              excerpt={excerpt(s.body ?? '', d.seoMetadescription ?? '')}
              more="Read more →"
              data={{
                title: d.title.toLowerCase(),
                authors: d.authors.join(' ').toLowerCase(),
                tags: d.tags.map((t) => t.toLowerCase()).join('|'),
              }}
            />
          );
        })}
      </div>
      <p class="no-results" id="noresults" hidden>No stories match your filters.</p>
    </div>
  </section>

  <style>
    /* Two-column intro: rotating hosts (left) + cyan explanation card (right) */
    .stories-intro { display: grid; grid-template-columns: 1fr; gap: var(--space-8); align-items: stretch; margin-bottom: var(--space-16); }
    .stories-intro > * { min-width: 0; }
    @media (min-width: 900px) { .stories-intro { grid-template-columns: 5fr 6fr; gap: var(--space-12); } }

    .si-hosts { display: flex; flex-direction: column; }
    .si-hosts .solo-carousel { flex: 1; display: flex; flex-direction: column; }
    .si-hosts .solo { flex: 1; min-height: 0; }
    /* Let the host photo fill the height set by the cyan card on its right. */
    .si-hosts :global(.org-card) { height: 100%; }
    .si-hosts :global(.org-photo) { aspect-ratio: auto; flex: 1; min-height: 12rem; }

    /* Cyan explanation card — .panel-cyan in patterns.css does the rest. */
    .si-about h1 { margin: 0 0 var(--space-4); font-size: var(--text-3xl); }
    .si-about p { margin: 0 0 var(--space-4); }
    .si-about p:last-child { margin-bottom: 0; }
    .si-btn { align-self: flex-start; margin-top: var(--space-6); }

    /* The solo carousel stretches to the height of the cyan card beside it. */
    .solo-track { height: 100%; }

    /* Archive */
    .archive { padding-bottom: var(--space-16); }
    .archive-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }

    /* Filters and cards come from patterns.css. */
    .filters { margin: 0 0 var(--space-8); }

    /* A three-up grid rather than a stack: 24 full-width cards made this page
       19,887px tall, which is not an archive anyone scrolls to the end of. */
    .story-list { --card-min: 20rem; }
  </style>

  <script>
    import { applyUrlFilter } from '../../lib/filter-url';

    // Rotating host carousel — shuffle order each load, then auto-advance.
    document.querySelectorAll<HTMLElement>('.solo-carousel').forEach((car) => {
      const track = car.querySelector<HTMLElement>('.solo-track');
      const dots = Array.from(car.querySelectorAll<HTMLButtonElement>('.solo-dots button'));
      if (!track) return;
      // Fisher–Yates shuffle of the slides.
      const slides = Array.from(track.children);
      for (let k = slides.length - 1; k > 0; k--) {
        const j = Math.floor(Math.random() * (k + 1));
        [slides[k], slides[j]] = [slides[j], slides[k]];
      }
      slides.forEach((s) => track.appendChild(s));
      const n = track.children.length;
      if (!n) return;
      let i = 0;
      let timer: ReturnType<typeof setInterval>;
      const set = (k: number) => {
        i = (k + n) % n;
        track.style.transform = `translateX(-${i * 100}%)`;
        dots.forEach((d, j) => d.classList.toggle('on', j === i));
      };
      const start = () => { timer = setInterval(() => set(i + 1), 6000); };
      const stop = () => clearInterval(timer);
      dots.forEach((d) => d.addEventListener('click', () => { stop(); set(Number(d.dataset.i)); start(); }));
      car.addEventListener('mouseenter', stop);
      car.addEventListener('mouseleave', start);
      set(0);
      start();
    });

    const cards = Array.from(document.querySelectorAll<HTMLElement>('#cards .story-card'));
    const q = document.getElementById('q') as HTMLInputElement;
    const fTag = document.getElementById('f-tag') as HTMLSelectElement;
    const reset = document.getElementById('f-reset') as HTMLButtonElement;
    const count = document.getElementById('count') as HTMLElement;
    const noResults = document.getElementById('noresults') as HTMLElement;

    function matches(c: HTMLElement): boolean {
      const term = q.value.trim().toLowerCase();
      const tag = fTag.value.toLowerCase();
      const d = c.dataset;
      const okTerm =
        !term ||
        (d.title ?? '').includes(term) ||
        (d.authors ?? '').includes(term) ||
        (d.tags ?? '').includes(term);
      const okTag = !tag || ('|' + (d.tags ?? '') + '|').includes('|' + tag + '|');
      return okTerm && okTag;
    }

    function apply() {
      let matched = 0;
      cards.forEach((c) => {
        const ok = matches(c);
        c.hidden = !ok;
        if (ok) matched++;
      });
      count.textContent = `${matched} stor${matched === 1 ? 'y' : 'ies'}`;
      noResults.hidden = matched > 0;
    }

    [q, fTag].forEach((el) => el.addEventListener('input', apply));
    reset.addEventListener('click', () => {
      q.value = '';
      fTag.value = '';
      apply();
    });

    // Landing from a legacy /facilitating-archdes_tag/<tag>/ URL.
    applyUrlFilter(fTag);
    apply();
  </script>
</BaseLayout>
