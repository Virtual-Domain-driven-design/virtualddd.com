---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrganiserCard from '../../components/OrganiserCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const stories = (await getCollection('stories')).sort(
  (a, b) => (b.data.episode ?? 0) - (a.data.episode ?? 0),
);

// The three stable hosts of the series (fixed order).
const organisers = await getCollection('organisers');
const byId = new Map(organisers.map((o) => [o.id, o]));
const hosts = ['andrea-magnorsky', 'andrew-harmel-law', 'kenny-baas-schwegler']
  .map((id) => byId.get(id))
  .filter(Boolean) as typeof organisers;

// Tag options for the filter (unique across stories).
const tagSet = new Set<string>();
for (const s of stories) for (const t of s.data.tags) tagSet.add(t.toLowerCase());
const tags = [...tagSet].sort();

const shortDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout
  title="Facilitating Stories — Virtual DDD"
  description="Real-world stories on facilitating software architecture and design — practical experiences from the community."
>
  <!-- Intro: hosts (rotating) + explanation card, two columns like the home page -->
  <section class="wrap">
    <div class="stories-intro">
      <div class="si-hosts">
        <p class="eyebrow eyebrow--cyan">Your hosts</p>
        <div class="solo-carousel">
          <div class="solo">
            <div class="solo-track">
              {hosts.map((o) => <div class="solo-slide"><OrganiserCard organiser={o} /></div>)}
            </div>
          </div>
          <div class="solo-dots">
            {hosts.map((_, i) => <button type="button" data-i={i} aria-label={`Host ${i + 1}`}></button>)}
          </div>
        </div>
      </div>

      <aside class="si-about">
        <p class="eyebrow eyebrow--dark">Facilitating Stories</p>
        <h1>Stories on Facilitating Software Design &amp; Architecture</h1>
        <p>
          Regardless of the architectural approach — from traditional enterprise to more hands-on,
          emergent methods — teams face similar obstacles when building effective systems. The core
          challenge remains how to build software that truly works and enables a smooth flow of delivery.
        </p>
        <p>
          So we started this series: real-world experiences from our community, sharing practical stories
          about the approaches that have delivered results — moving beyond the theoretical and into the
          practical.
        </p>
      </aside>
    </div>
  </section>

  <!-- Story archive -->
  <section class="archive">
    <div class="wrap">
      <div class="archive-head">
        <p class="eyebrow eyebrow--cyan">All stories</p>
        <span class="result-count" id="count"></span>
      </div>

      <div class="filters">
        <input type="search" id="q" placeholder="Search title, author or tag…" aria-label="Search stories" />
        <select id="f-tag" aria-label="Filter by tag">
          <option value="">All tags</option>
          {tags.map((t) => <option value={t}>{t}</option>)}
        </select>
        <button id="f-reset" type="button">Reset</button>
      </div>

      <div class="story-list" id="cards">
        {stories.map((s) => {
          const d = s.data;
          const img = d.featuredImage ?? d.featuredImageSquared;
          const iso = d.publishedDate ? new Date(d.publishedDate).toISOString() : '';
          const fallback = d.publishedDate ? shortDate(new Date(d.publishedDate)) : '';
          return (
            <a
              class="story-row"
              href={`/facilitating-archdes/${s.id}/`}
              data-title={d.title.toLowerCase()}
              data-authors={d.authors.join(' ').toLowerCase()}
              data-tags={d.tags.map((t) => t.toLowerCase()).join('|')}
            >
              <div class="sr-thumb">
                {img ? <Image src={img} alt="" width={640} loading="lazy" /> : <div class="sr-ph"></div>}
                {d.episode != null && <span class="badge badge--type sr-ep">Ep {d.episode}</span>}
              </div>
              <div class="sr-info">
                {iso && (
                  <p class="sr-date">
                    <time class="js-local" data-format="shortdate" datetime={iso} data-iso={iso}>{fallback}</time>
                  </p>
                )}
                <h3 class="sr-title">{d.title}</h3>
                {d.authors.length > 0 && (
                  <p class="sr-authors">by {d.authors.slice(0, 3).join(', ')}{d.authors.length > 3 ? ' & more' : ''}</p>
                )}
                {d.seoMetadescription && <p class="sr-excerpt">{d.seoMetadescription}</p>}
                <span class="sr-more">Read story →</span>
              </div>
            </a>
          );
        })}
      </div>
      <p class="no-results" id="noresults" hidden>No stories match your filters.</p>
    </div>
  </section>

  <style>
    /* Shared brand section label */
    .eyebrow { display: inline-flex; align-items: center; gap: var(--space-3); font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--text-sm); margin: 0 0 var(--space-5); }
    .eyebrow::before { content: ''; width: 1.75rem; height: 2px; }
    .eyebrow--cyan { color: var(--color-primary); }
    .eyebrow--cyan::before { background: var(--color-primary); }
    .eyebrow--dark { color: rgba(13, 14, 18, 0.7); }
    .eyebrow--dark::before { background: rgba(13, 14, 18, 0.7); }

    /* Two-column intro: rotating hosts (left) + cyan explanation card (right) */
    .stories-intro { display: grid; grid-template-columns: 1fr; gap: var(--space-8); align-items: stretch; margin-bottom: var(--space-16); }
    .stories-intro > * { min-width: 0; }
    @media (min-width: 900px) { .stories-intro { grid-template-columns: 5fr 6fr; gap: var(--space-12); } }

    .si-hosts { display: flex; flex-direction: column; }
    .si-hosts .solo-carousel { flex: 1; display: flex; flex-direction: column; }
    .si-hosts :global(.org-photo) { aspect-ratio: 4 / 5; }

    /* Cyan explanation card (mirrors home .ns-about) */
    .si-about { background: var(--color-primary); color: #0d0e12; border-radius: var(--radius); padding: var(--space-8); display: flex; flex-direction: column; justify-content: center; }
    .si-about h1 { margin: 0 0 var(--space-4); font-size: var(--text-3xl); color: #0d0e12; }
    .si-about p { color: rgba(13, 14, 18, 0.82); margin: 0 0 var(--space-4); }
    .si-about p:last-child { margin-bottom: 0; }

    /* Solo carousel (reused from home page) */
    .solo { overflow: hidden; border-radius: var(--radius); }
    .solo-track { display: flex; transition: transform 0.5s ease; height: 100%; }
    .solo-slide { flex: 0 0 100%; min-width: 0; }
    .solo-dots { display: flex; gap: var(--space-2); margin-top: var(--space-4); }
    .solo-dots button { width: 9px; height: 9px; border-radius: 0; border: 0; background: var(--color-border); cursor: pointer; padding: 0; transition: width 0.2s, background 0.2s; }
    .solo-dots button.on { background: var(--color-primary); width: 24px; }

    /* Archive */
    .archive { padding-bottom: var(--space-16); }
    .archive-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
    .result-count { color: var(--color-text-muted); font-size: var(--text-sm); }

    .filters { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; margin: 0 0 var(--space-8); }
    .filters input, .filters select {
      font-family: var(--font-body); font-size: var(--text-base);
      padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border);
      border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-text);
    }
    .filters input { flex: 1 1 20rem; }
    .filters input:focus, .filters select:focus { outline: none; border-color: var(--color-primary); }
    .filters #f-reset { font-family: var(--font-heading); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; cursor: pointer; padding: var(--space-3) var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: transparent; color: var(--color-text-muted); }
    .filters #f-reset:hover { color: var(--color-text); border-color: var(--color-primary); }

    /* Single-column story list */
    .story-list { display: flex; flex-direction: column; gap: var(--space-6); }
    .story-row { display: grid; grid-template-columns: 1fr; background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s; }
    .story-row:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: color-mix(in srgb, var(--color-primary) 60%, var(--color-border)); text-decoration: none; }
    .story-row:hover .sr-more { color: var(--color-primary); }
    .sr-thumb { position: relative; aspect-ratio: 16 / 9; background: var(--color-surface); }
    .sr-thumb :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
    .sr-ph { width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-accent), var(--color-primary)); }
    .sr-ep { position: absolute; top: var(--space-3); left: var(--space-3); }
    .sr-info { padding: var(--space-6) var(--space-8); display: flex; flex-direction: column; }
    .sr-date { font-family: var(--font-heading); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-primary); font-size: var(--text-sm); margin: 0 0 var(--space-2); }
    .sr-title { font-size: var(--text-2xl); margin: 0; line-height: 1.15; }
    .sr-authors { font-size: var(--text-sm); color: var(--color-text-muted); margin: var(--space-2) 0 0; }
    .sr-excerpt { color: var(--color-text-muted); margin: var(--space-4) 0 0; }
    .sr-more { font-family: var(--font-heading); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; font-size: var(--text-sm); color: var(--color-text-muted); margin-top: var(--space-5); transition: color 0.15s; }
    .no-results { color: var(--color-text-muted); }

    @media (min-width: 760px) {
      .story-row { grid-template-columns: 320px 1fr; align-items: stretch; }
      .sr-thumb { aspect-ratio: auto; }
      .sr-info { justify-content: center; }
    }
  </style>

  <script>
    // Rotating host carousel — shuffle order each load, then auto-advance.
    document.querySelectorAll<HTMLElement>('.solo-carousel').forEach((car) => {
      const track = car.querySelector<HTMLElement>('.solo-track');
      const dots = Array.from(car.querySelectorAll<HTMLButtonElement>('.solo-dots button'));
      if (!track) return;
      // Fisher–Yates shuffle of the slides.
      const slides = Array.from(track.children);
      for (let k = slides.length - 1; k > 0; k--) {
        const j = Math.floor(Math.random() * (k + 1));
        [slides[k], slides[j]] = [slides[j], slides[k]];
      }
      slides.forEach((s) => track.appendChild(s));
      const n = track.children.length;
      if (!n) return;
      let i = 0;
      let timer: ReturnType<typeof setInterval>;
      const set = (k: number) => {
        i = (k + n) % n;
        track.style.transform = `translateX(-${i * 100}%)`;
        dots.forEach((d, j) => d.classList.toggle('on', j === i));
      };
      const start = () => { timer = setInterval(() => set(i + 1), 6000); };
      const stop = () => clearInterval(timer);
      dots.forEach((d) => d.addEventListener('click', () => { stop(); set(Number(d.dataset.i)); start(); }));
      car.addEventListener('mouseenter', stop);
      car.addEventListener('mouseleave', start);
      set(0);
      start();
    });

    const cards = Array.from(document.querySelectorAll<HTMLElement>('#cards .story-row'));
    const q = document.getElementById('q') as HTMLInputElement;
    const fTag = document.getElementById('f-tag') as HTMLSelectElement;
    const reset = document.getElementById('f-reset') as HTMLButtonElement;
    const count = document.getElementById('count') as HTMLElement;
    const noResults = document.getElementById('noresults') as HTMLElement;

    function matches(c: HTMLElement): boolean {
      const term = q.value.trim().toLowerCase();
      const tag = fTag.value.toLowerCase();
      const d = c.dataset;
      const okTerm =
        !term ||
        (d.title ?? '').includes(term) ||
        (d.authors ?? '').includes(term) ||
        (d.tags ?? '').includes(term);
      const okTag = !tag || ('|' + (d.tags ?? '') + '|').includes('|' + tag + '|');
      return okTerm && okTag;
    }

    function apply() {
      let matched = 0;
      cards.forEach((c) => {
        const ok = matches(c);
        c.hidden = !ok;
        if (ok) matched++;
      });
      count.textContent = `${matched} stor${matched === 1 ? 'y' : 'ies'}`;
      noResults.hidden = matched > 0;
    }

    [q, fTag].forEach((el) => el.addEventListener('input', apply));
    reset.addEventListener('click', () => {
      q.value = '';
      fTag.value = '';
      apply();
    });
    apply();
  </script>
</BaseLayout>
