---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SideExtras from '../../components/SideExtras.astro';
import DiscussedHeuristics from '../../components/DiscussedHeuristics.astro';
import PersonRow from '../../components/PersonRow.astro';
import PrevNext from '../../components/PrevNext.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { youtubeEmbed } from '../../lib/embeds';
import { excerpt } from '../../lib/excerpt';
import { storyJsonLd, pageTitle, trail, type PersonInput } from '../../lib/seo';
import { socialCard } from '../../lib/social-card';
import { iso as toIso, longDate, shortDate } from '../../lib/dates';
import { profileLinks, samePerson } from '../../lib/people';
import { guestsById, heuristicsById, resolveRefs, siblings, type Teaser } from '../../lib/collections';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((story) => ({ params: { slug: story.id }, props: { story, stories } }));
}

const { story, stories } = Astro.props;
const { Content } = await render(story);
const d = story.data;

const discussed = resolveRefs(d.curatedHeuristics, await heuristicsById());
const videoEmbed = youtubeEmbed(d.youtube);

// The people on the episode. Guests are a relation to the same database the
// sessions use, so someone who has told a story and spoken at a session is one
// row with one bio; hosts are organisers, matched by name for the portrait and
// the link to their page, exactly as a session matches its organiser.
const organisers = await getCollection('organisers');
const guests = resolveRefs(d.guests, await guestsById()).map((g) => {
  const also = organisers.find((o) => samePerson(o.data.name, g.data.name));
  const links = profileLinks(g.data);
  return {
    name: g.data.name,
    bio: g.data.bio,
    photo: g.data.photo ?? also?.data.photo,
    href: also ? `/organisers/${also.id}/` : undefined,
    links: links.length ? links : profileLinks(also?.data ?? {}),
  };
});
const hosts = d.hosts.map((name) => {
  const o = organisers.find((x) => samePerson(x.data.name, name));
  return { name: o?.data.name ?? name, role: o?.data.role, photo: o?.data.photo,
    href: o ? `/organisers/${o.id}/` : undefined, links: profileLinks(o?.data ?? {}) };
});

// "by the guest, with the hosts". The guest told the story and the hosts asked
// the questions, and a byline that lumps them into one list says neither. An
// episode with no outside guest is the hosts talking to each other, so they are
// the ones it is by. `authors` is the last resort, for a story nobody has
// curated into Guests and Hosts yet.
const guestNames = guests.map((g) => g.name);
const hostNames = hosts.map((h) => h.name);
const bylineBy = guestNames.length ? guestNames : (hostNames.length ? hostNames : d.authors);
const bylineWith = guestNames.length ? hostNames : [];
const credited = [...guestNames, ...hostNames];

const asPerson = (p: typeof guests[number] | typeof hosts[number]): PersonInput => ({
  name: p.name,
  bio: 'bio' in p ? p.bio : undefined,
  role: 'role' in p ? p.role : undefined,
  url: p.links.find((l) => l.label === 'Website')?.href,
  sameAs: p.links.map((l) => l.href),
  page: p.href ? new URL(p.href, Astro.site).toString() : undefined,
});

// Prev / next by episode.
const byEpisode = [...stories].sort((a, b) => (a.data.episode ?? 0) - (b.data.episode ?? 0));
const { prev, next } = siblings(byEpisode, story.id);

// Latest stories for the sidebar (most recent episodes, excluding this one).
const latest: Teaser[] = [...stories]
  .filter((s) => s.id !== story.id)
  .sort((a, b) => (b.data.episode ?? 0) - (a.data.episode ?? 0))
  .slice(0, 3)
  .map((s) => ({
    href: `/facilitating-archdes/${s.id}/`,
    title: s.data.title,
    img: s.data.featuredImage ?? s.data.featuredImageSquared,
    iso: s.data.publishedDate ? toIso(s.data.publishedDate) : undefined,
    fallback: s.data.publishedDate ? shortDate(s.data.publishedDate) : undefined,
  }));

const iso = d.publishedDate ? toIso(d.publishedDate) : '';
const dateStr = d.publishedDate ? longDate(d.publishedDate) : '';

const url = new URL(`/facilitating-archdes/${story.id}/`, Astro.site).toString();
const image = d.featuredImage ?? d.featuredImageSquared;
const description = d.seoMetadescription ?? excerpt(story.body ?? '', d.title, 155);
const jsonLd = storyJsonLd(Astro.site, story, {
  url,
  image: image ? await socialCard(Astro.site, image) : undefined,
  trail: trail('stories', d.title, `/facilitating-archdes/${story.id}/`),
  // On the eighteen episodes with no outside guest, the hosts are the authors:
  // it is their story being told, not an interview.
  authors: (guests.length ? guests : hosts).map(asPerson),
  contributors: guests.length ? hosts.map(asPerson) : [],
});
---

<BaseLayout
  title={pageTitle(d.seoTitle ?? d.title)}
  description={description}
  image={image}
  ogType="article"
  jsonLd={jsonLd}
  markdown
>
  <article class="story detail wrap">
    <div class="detail-head">
      <p class="detail-back" data-pagefind-ignore><a href="/facilitating-archdes/">← All stories</a></p>
      <p class="eyebrow eyebrow--pink">Facilitating Stories</p>
      <h1>{d.title}</h1>
      {bylineBy.length > 0 && (
        <p class="byline">
          by <strong>{bylineBy.join(', ')}</strong>{bylineWith.length > 0 && (
            <Fragment> with <strong>{bylineWith.join(', ')}</strong></Fragment>
          )}
        </p>
      )}
      {videoEmbed ? (
        <div class="video">
          <iframe src={videoEmbed} title={d.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
      ) : d.featuredImage ? (
        <Image class="media-hero" src={d.featuredImage} alt={d.title} width={920} />
      ) : null}

      {d.podcast && (
        <iframe class="podcast" src={d.podcast} title="Podcast player" loading="lazy" width="100%" height="170"></iframe>
      )}
    </div>

    <aside class="detail-side">
      <div class="side-card">
        {d.episode != null && <p class="side-ep">Episode {d.episode}</p>}
        {iso && <p class="side-date"><time class="js-local" data-format="date" datetime={iso} data-iso={iso}>{dateStr}</time></p>}
        {credited.length > 0 && <p class="side-authors">{credited.join(', ')}</p>}
        {(d.youtube || d.podcast) && (
          <div class="side-links">
            {d.youtube && <a class="btn btn--accent btn--sm btn--block" href={d.youtube}>Watch on YouTube ↗</a>}
            {d.podcast && <a class="btn btn--ghost btn--sm btn--block" href={d.podcast}>Listen to the podcast ↗</a>}
          </div>
        )}
      </div>

      {d.tags.length > 0 && (
        <div class="side-block">
          <p class="eyebrow eyebrow--cyan">Tags</p>
          <div class="chips">{d.tags.map((t) => <span class="chip chip--outline">{t}</span>)}</div>
        </div>
      )}

      <SideExtras latest={latest} latestLabel="Latest stories" latestAllHref="/facilitating-archdes/" />
    </aside>

    <div class="detail-body">
      <div class="prose-body"><Content /></div>

      {guests.length > 0 && (
        <section class="people-card">
          <h2>{guests.length === 1 ? 'Guest' : 'Guests'}</h2>
          <ul class="people">
            {guests.map((g) => (
              <li data-test="guest">
                <PersonRow name={g.name} bio={g.bio} photo={g.photo} href={g.href} links={g.links} stacked />
              </li>
            ))}
          </ul>
        </section>
      )}

      {hosts.length > 0 && (
        <section class="people-card">
          <h2>{hosts.length === 1 ? 'Host' : 'Hosts'}</h2>
          <ul class="people">
            {hosts.map((h) => (
              <li data-test="host">
                <PersonRow name={h.name} role={h.role} photo={h.photo} href={h.href} links={h.links} stacked />
              </li>
            ))}
          </ul>
        </section>
      )}

      <DiscussedHeuristics heuristics={discussed} />

      <PrevNext
        noun="story"
        prev={prev && { href: `/facilitating-archdes/${prev.id}/`, title: prev.data.title }}
        next={next && { href: `/facilitating-archdes/${next.id}/`, title: next.data.title }}
      />
    </div>
  </article>

  <style>
    /* Eyebrow, layout, media and prose come from patterns.css. */
    .detail-head h1 { margin: 0 0 var(--space-3); }
    .byline { color: var(--color-text-muted); margin: 0 0 var(--space-8); }

    .side-card { background: var(--color-surface); border: 1px solid var(--color-border); padding: var(--space-6); }
    .side-ep { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent-dark); margin: 0 0 var(--space-1); font-size: var(--text-sm); }
    .side-date { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); margin: 0 0 var(--space-1); }
    .side-authors { color: var(--color-text-muted); margin: 0 0 var(--space-5); font-size: var(--text-sm); }
    .side-links { display: flex; flex-direction: column; gap: var(--space-3); }

    /* Guests and hosts — the same panels a session uses, so a person looks the
       same wherever the community met them. */
    .people-card { background: var(--color-surface); border-radius: var(--radius); padding: var(--space-6); margin: var(--space-8) 0; }
    .people-card h2 { margin-top: 0; }
    .people { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-6); }
    .people li + li { border-top: 1px solid var(--color-border); padding-top: var(--space-6); }

    .side-block { margin-top: var(--space-8); }
    .side-block .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  </style>
</BaseLayout>
