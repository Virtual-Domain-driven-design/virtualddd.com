---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((story) => ({ params: { slug: story.id }, props: { story, stories } }));
}

const { story, stories } = Astro.props;
const { Content } = await render(story);
const d = story.data;

// Discussed heuristics — resolve defensively.
const heuristics = await getCollection('heuristics');
const heurById = new Map(heuristics.map((h) => [h.id, h]));
const discussed = d.curatedHeuristics.map((r) => heurById.get(r.id)).filter(Boolean);

function youtubeEmbed(url?: string): string | null {
  if (!url) return null;
  let m: RegExpMatchArray | null;
  let id: string | undefined;
  if ((m = url.match(/youtube\.com\/embed\/([^?/&]+)/))) id = m[1];
  else if ((m = url.match(/youtu\.be\/([^?/&]+)/))) id = m[1];
  else if ((m = url.match(/youtube\.com\/live\/([^?/&]+)/))) id = m[1];
  else if ((m = url.match(/[?&]v=([^&]+)/))) id = m[1];
  return id ? `https://www.youtube-nocookie.com/embed/${id}` : null;
}
const videoEmbed = youtubeEmbed(d.youtube);

// Prev / next by episode.
const ordered = [...stories].sort((a, b) => (a.data.episode ?? 0) - (b.data.episode ?? 0));
const idx = ordered.findIndex((s) => s.id === story.id);
const prev = ordered[idx - 1];
const next = ordered[idx + 1];

const iso = d.publishedDate ? new Date(d.publishedDate).toISOString() : '';
const dateStr = d.publishedDate
  ? new Date(d.publishedDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';
---

<BaseLayout title={`${d.seoTitle ?? d.title} — Virtual DDD`} description={d.seoMetadescription}>
  <article class="story wrap">
    <div class="s-head">
      <p class="back"><a href="/facilitating-archdes/">← All stories</a></p>
      <span class="badge badge--type">Facilitating Stories</span>
      <h1>{d.title}</h1>
      {videoEmbed ? (
        <div class="video">
          <iframe src={videoEmbed} title={d.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
      ) : d.featuredImage ? (
        <Image class="hero" src={d.featuredImage} alt={d.title} width={920} />
      ) : null}
    </div>

    <aside class="s-side">
      <div class="side-card">
        {d.episode != null && <p class="side-ep">Episode {d.episode}</p>}
        {iso && <p class="side-date"><time class="js-local" data-format="date" datetime={iso} data-iso={iso}>{dateStr}</time></p>}
        {d.authors.length > 0 && <p class="side-authors">{d.authors.join(', ')}</p>}
        {(d.youtube || d.podcast) && (
          <p class="side-links">
            {d.youtube && <a href={d.youtube}>Watch on YouTube ↗</a>}
            {d.podcast && <a href={d.podcast}>Listen to the podcast ↗</a>}
          </p>
        )}
      </div>

      {d.tags.length > 0 && (
        <div class="side-block">
          <h3>Tags</h3>
          <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </div>
      )}

      {discussed.length > 0 && (
        <div class="side-block">
          <h3>Discussed heuristics</h3>
          <ul class="heur-list">{discussed.map((h) => <li>{h!.data.title}</li>)}</ul>
        </div>
      )}
    </aside>

    <div class="s-body">
      <div class="body"><Content /></div>
      <nav class="prevnext">
        {prev ? <a href={`/facilitating-archdes/${prev.id}/`}>← {prev.data.title}</a> : <span />}
        {next && <a class="pn-next" href={`/facilitating-archdes/${next.id}/`}>{next.data.title} →</a>}
      </nav>
    </div>
  </article>

  <style>
    .story { display: grid; grid-template-columns: 1fr; gap: var(--space-8); }
    .back { font-size: var(--text-sm); margin-bottom: var(--space-3); }
    .s-head h1 { margin: var(--space-3) 0 var(--space-6); }

    .video { position: relative; aspect-ratio: 16 / 9; overflow: hidden; box-shadow: var(--shadow); background: #000; }
    .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .hero { width: 100%; box-shadow: var(--shadow); }

    .side-card { background: var(--color-surface); padding: var(--space-6); }
    .side-ep { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-accent-dark); margin: 0 0 var(--space-1); font-size: var(--text-sm); }
    .side-date { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); margin: 0 0 var(--space-1); }
    .side-authors { color: var(--color-text-muted); margin: 0 0 var(--space-4); }
    .side-links { display: flex; flex-direction: column; gap: var(--space-1); margin: 0; font-size: var(--text-sm); }
    .side-block { margin-top: var(--space-6); }
    .side-block h3 { font-size: var(--text-base); text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); margin: 0 0 var(--space-3); }
    .side-block .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
    .heur-list { margin: 0; padding-left: var(--space-4); font-size: var(--text-sm); }
    .heur-list li { margin-bottom: var(--space-2); }

    .body :global(h2) { margin-top: var(--space-8); }
    .body :global(img) { margin: var(--space-4) 0; }
    .prevnext { display: flex; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-12); padding-top: var(--space-6); border-top: 1px solid var(--color-border); font-family: var(--font-heading); font-weight: 600; }
    .prevnext .pn-next { margin-left: auto; text-align: right; }

    @media (min-width: 900px) {
      .story {
        grid-template-columns: minmax(0, 1fr) 19rem;
        grid-template-areas: "head side" "body side";
        grid-template-rows: auto 1fr;
        column-gap: var(--space-12);
        row-gap: var(--space-6);
        align-items: start;
      }
      .s-head { grid-area: head; }
      .s-body { grid-area: body; }
      .s-side { grid-area: side; position: sticky; top: 5.5rem; align-self: start; }
    }
  </style>
</BaseLayout>
