---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageJsonLd, topTrail } from '../lib/seo';
const jsonLd = pageJsonLd(Astro.site, {
  url: new URL('/privacy-policy/', Astro.site).toString(),
  name: 'Privacy Policy',
  description: "How the Virtual DDD website handles your data, in plain terms.",
  trail: topTrail('Privacy Policy', '/privacy-policy/'),
});

---

<BaseLayout
  title="Privacy Policy — Virtual DDD"
  description="How the Virtual DDD website handles your data, in plain terms."
  jsonLd={jsonLd}
>
  <div class="wrap page">
    <p class="eyebrow eyebrow--pink">Legal</p>
    <h1>Privacy Policy</h1>

    <div class="prose prose-muted">
      <p>
        Virtual DDD is a small, volunteer-run community. We try to keep things simple and to collect as
        little as possible. This page explains, in plain terms, how the website handles data.
      </p>

      <h2>The website</h2>
      <p>
        This website is a static site. It does not ask you to create an account or submit personal
        information to us directly, and it has no comment forms or logins.
      </p>

      <h2>Visitor statistics</h2>
      <p>
        We count page views, so that we know which sessions, stories and heuristics people actually
        find useful. We use <a href="https://plausible.io/">Plausible</a>, an open-source analytics
        service that stores its data in the European Union.
      </p>
      <p>
        It sets <strong>no cookies</strong> and does not follow you between websites. It records the
        page you viewed, the site that linked you to it, and rough details of your browser, operating
        system, device type and country. It does not store your IP address, and nothing it collects
        identifies you as a person. That is also why this site has no cookie banner: there is nothing
        to ask you to consent to.
      </p>

      <h2>Third-party content and services</h2>
      <p>
        Some pages embed or link to third-party services, each of which has its own privacy policy and may
        set its own cookies or collect data when you interact with them:
      </p>
      <ul>
        <li><strong>YouTube</strong> — for session and story recordings (we use the privacy-enhanced player).</li>
        <li><strong>Captivate</strong> — for the embedded podcast players.</li>
        <li><strong>Humanitix</strong> — for event registration and RSVPs.</li>
        <li><strong>Discord</strong> — for our community chat.</li>
        <li><strong>Bluesky, LinkedIn &amp; Mastodon</strong> — for our social channels.</li>
      </ul>
      <p>
        When you follow those links or interact with embedded content, your data is handled under the
        respective service's privacy policy.
      </p>

      <h2>Contact</h2>
      <p>
        If you have any questions about privacy, or a request regarding your data, email us at{' '}
        <a href="mailto:organisers@virtualddd.com">organisers@virtualddd.com</a> or reach out on{' '}
        <a href="https://discord.gg/tRJkcsFDKN">Discord</a>.
      </p>
    </div>
  </div>

  <style>
    .page { max-width: 48rem; padding-block: var(--space-8) var(--space-16); }
    .page h1 { margin: 0 0 var(--space-8); }
  </style>
</BaseLayout>
