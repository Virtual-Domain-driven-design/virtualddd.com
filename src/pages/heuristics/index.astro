---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeuristicBrowser from '../../components/HeuristicBrowser.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import rebecca from '../../assets/rebecca-wirfs-brock.jpg';

const all = (await getCollection('heuristics')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Heuristics — Virtual DDD"
  description="A curated, growing collection of heuristics for systems and software design — rules of thumb that help you decide what to do next."
>
  <section class="hero">
    <Image class="hero-bg" src={rebecca} alt="Rebecca Wirfs-Brock speaking on stage" width={1600} />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-text">
        <h1>Heuristics</h1>
        <blockquote class="hero-quote">
          <p>
            We all use heuristics (even if we haven't articulated them to others) to discover, understand,
            explore, create, modify, or extend complex software systems. Billy Vaughn Koen, in Discussion
            of the Method: Conducting the Engineer's Approach to Problem Solving, defines a heuristic as,
            "anything that provides a plausible aid or direction in the solution of a problem but is in the
            final analysis unjustified, incapable of justification, and potentially fallible."
          </p>
          <cite>— Rebecca Wirfs-Brock —</cite>
        </blockquote>
        <a class="btn btn--accent hero-btn" href="/ddd-heuristics/">More info →</a>
      </div>
    </div>
  </section>

  <div class="wrap all">
    <p class="eyebrow eyebrow--cyan">Browse the collection</p>
    <HeuristicBrowser items={all} showBanners />
  </div>

  <style>
    .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--color-border); margin-top: calc(-1 * var(--space-12)); }
    .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 75% center; }
    .hero-scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.82) 38%, rgba(0,0,0,0.35) 68%, rgba(0,0,0,0) 100%); }
    .hero-inner { position: relative; padding-block: var(--space-12); }
    .hero-text { max-width: 40rem; }
    .hero-text h1 { color: var(--color-primary); font-size: clamp(2.2rem, 3vw + 1.4rem, var(--text-4xl)); margin: 0 0 var(--space-6); }
    .hero-quote { margin: 0; }
    .hero-quote p { font-style: italic; font-family: var(--font-heading); font-weight: 500; font-size: clamp(1.1rem, 0.8vw + 0.95rem, var(--text-xl)); line-height: 1.55; color: #fff; margin: 0 0 var(--space-4); text-shadow: 0 1px 10px rgba(0,0,0,0.5); }
    .hero-quote cite { font-style: italic; font-family: var(--font-heading); font-weight: 600; color: #fff; text-shadow: 0 1px 10px rgba(0,0,0,0.5); }
    .hero-btn { margin-top: var(--space-6); }
    @media (max-width: 799.98px) { .hero-scrim { background: linear-gradient(90deg, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.8) 60%, rgba(0,0,0,0.55) 100%); } }

    .all { margin-block: var(--space-12) var(--space-16); }
  </style>
</BaseLayout>
