---
/** One route, two page kinds: the three type indexes
 *  (`/heuristics/design-heuristics/`) and every heuristic detail page.
 *  They share the `[slug]` namespace, so they must share the route file; the
 *  bodies live in components so each can be typed on its own. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeuristicDetail from '../../components/HeuristicDetail.astro';
import HeuristicTypePage from '../../components/HeuristicTypePage.astro';
import { getCollection } from 'astro:content';
import { HEURISTIC_TYPES } from '../../lib/heuristics';
import { curatesHeuristic, HEURISTIC_RELATIONS } from '../../lib/collections';
import { breadcrumbs, graph, heuristicJsonLd, heuristicSet, organization, pageTitle, trail } from '../../lib/seo';
import { socialCard } from '../../lib/social-card';
import { excerpt } from '../../lib/excerpt';

export async function getStaticPaths() {
  const all = (await getCollection('heuristics')).sort((a, b) => a.data.title.localeCompare(b.data.title));
  return [
    ...HEURISTIC_TYPES.map((type) => ({
      params: { slug: type.key },
      props: { kind: 'type' as const, type, items: all.filter((h) => h.data.type[0] === type.key) },
    })),
    ...all.map((heuristic) => ({
      params: { slug: heuristic.id },
      props: { kind: 'detail' as const, heuristic, all },
    })),
  ];
}

const props = Astro.props;
// The type indexes keep the brand; a single heuristic does not (see pageTitle).
const title =
  props.kind === 'type'
    ? pageTitle(props.type.title, { brand: true })
    : pageTitle(props.heuristic.data.seoTitle ?? props.heuristic.data.title);
// `metaDescription` is the editorial one from Notion and was being ignored here,
// so 35 hand-written descriptions never reached a page. The question is the
// fallback: it is a question, not a description, and often under 70 characters.
const description =
  props.kind === 'type'
    ? props.type.text
    // The body's opening sentence *is* the heuristic, so it makes a far better
    // snippet than the question — which is a question, and was under 70
    // characters on 56 of these pages. The question stays as the last resort.
    : props.heuristic.data.metaDescription
      ?? excerpt(props.heuristic.body ?? '', props.heuristic.data.question ?? '', 165)
      ?? props.heuristic.data.question
      ?? props.heuristic.data.title;

// Structured data. A heuristic is the most quotable thing on this site — a
// named, self-contained rule with an author and a graph around it — and until
// now 154 of them shipped as unlabelled prose. The type pages are excluded
// from the sitemap and get the collection instead.
const url = (path: string) => new URL(path, Astro.site).toString();
let jsonLd: Record<string, unknown>;
if (props.kind === 'type') {
  jsonLd = graph(
    organization(Astro.site),
    heuristicSet(Astro.site),
    breadcrumbs(Astro.site, trail('heuristics', props.type.title, `/heuristics/${props.type.key}/`)),
  );
} else {
  const { heuristic, all } = props;
  const byId = new Map(all.map((h) => [h.id, h]));
  // Only published heuristics are in the collection, so an unresolved relation
  // is one still being curated; it joins the graph when it is published.
  const related = [
    ...new Set(
      HEURISTIC_RELATIONS.flatMap(([field]) => heuristic.data[field] ?? [])
        .map((r) => byId.get(r.id))
        .filter((h) => h !== undefined)
        .map((h) => url(`/heuristics/${h!.id}/`)),
    ),
  ];
  const discussedIn = [
    ...(await getCollection('sessions'))
      .filter((s) => curatesHeuristic(s, heuristic.id))
      .map((s) => ({ name: s.data.title, url: url(`/sessions/${s.id}/`) })),
    ...(await getCollection('stories'))
      .filter((s) => curatesHeuristic(s, heuristic.id))
      .map((s) => ({ name: s.data.title, url: url(`/facilitating-archdes/${s.id}/`) })),
  ];
  jsonLd = heuristicJsonLd(Astro.site, heuristic, {
    url: url(`/heuristics/${heuristic.id}/`),
    description,
    image: heuristic.data.featuredImage ? await socialCard(Astro.site, heuristic.data.featuredImage) : undefined,
    related,
    discussedIn,
    trail: trail('heuristics', heuristic.data.title, `/heuristics/${heuristic.id}/`),
  });
}
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} markdown={props.kind === 'detail'}>
  {props.kind === 'type'
    ? <HeuristicTypePage type={props.type} items={props.items} />
    : <HeuristicDetail heuristic={props.heuristic} all={props.all} />}
</BaseLayout>
