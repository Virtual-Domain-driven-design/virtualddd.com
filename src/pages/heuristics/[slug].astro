---
/** One route, two page kinds: the three type indexes
 *  (`/heuristics/design-heuristics/`) and every heuristic detail page.
 *  They share the `[slug]` namespace, so they must share the route file; the
 *  bodies live in components so each can be typed on its own. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeuristicDetail from '../../components/HeuristicDetail.astro';
import HeuristicTypePage from '../../components/HeuristicTypePage.astro';
import { getCollection } from 'astro:content';
import { HEURISTIC_TYPES } from '../../lib/heuristics';
import { pageTitle } from '../../lib/seo';
import { excerpt } from '../../lib/excerpt';

export async function getStaticPaths() {
  const all = (await getCollection('heuristics')).sort((a, b) => a.data.title.localeCompare(b.data.title));
  return [
    ...HEURISTIC_TYPES.map((type) => ({
      params: { slug: type.key },
      props: { kind: 'type' as const, type, items: all.filter((h) => h.data.type[0] === type.key) },
    })),
    ...all.map((heuristic) => ({
      params: { slug: heuristic.id },
      props: { kind: 'detail' as const, heuristic, all },
    })),
  ];
}

const props = Astro.props;
// The type indexes keep the brand; a single heuristic does not (see pageTitle).
const title =
  props.kind === 'type'
    ? pageTitle(props.type.title, { brand: true })
    : pageTitle(props.heuristic.data.seoTitle ?? props.heuristic.data.title);
// `metaDescription` is the editorial one from Notion and was being ignored here,
// so 35 hand-written descriptions never reached a page. The question is the
// fallback: it is a question, not a description, and often under 70 characters.
const description =
  props.kind === 'type'
    ? props.type.text
    // The body's opening sentence *is* the heuristic, so it makes a far better
    // snippet than the question — which is a question, and was under 70
    // characters on 56 of these pages. The question stays as the last resort.
    : props.heuristic.data.metaDescription
      ?? excerpt(props.heuristic.body ?? '', props.heuristic.data.question ?? '', 165)
      ?? props.heuristic.data.question
      ?? props.heuristic.data.title;
---

<BaseLayout title={title} description={description}>
  {props.kind === 'type'
    ? <HeuristicTypePage type={props.type} items={props.items} />
    : <HeuristicDetail heuristic={props.heuristic} all={props.all} />}
</BaseLayout>
