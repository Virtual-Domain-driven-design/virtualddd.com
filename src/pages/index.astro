---
import BaseLayout from '../layouts/BaseLayout.astro';
import DiscordCard from '../components/DiscordCard.astro';
import FeaturedSession from '../components/FeaturedSession.astro';
import SessionCard from '../components/SessionCard.astro';
import StoryCard from '../components/StoryCard.astro';
import OrganiserCard from '../components/OrganiserCard.astro';
import ConferenceCard from '../components/ConferenceCard.astro';
import Carousel from '../components/Carousel.astro';
import AiUsage from '../components/AiUsage.astro';
import { getCollection } from 'astro:content';
import { splitSessions } from '../lib/collections';
import { orderConferences } from '../lib/conferences';
import { iso } from '../lib/dates';
import { HEURISTIC_TYPES } from '../lib/heuristics';
import { graph, organization, SITE_NAME, SITE_TAGLINE } from '../lib/seo';

// Every upcoming session ships in the HTML, soonest first, with all but the
// first hidden. The `js-next` sweep re-picks in the browser, so once a session
// finishes the home page moves to the following one on its own.
const { upcoming, past } = await splitSessions();
const latest = past.slice(0, 8);
const team = (await getCollection('organisers')).filter((o) => o.data.showOnTeam);

// Soonest first, with editions that have been at the end. Ordered again in the
// browser, because a conference finishing rebuilds nothing — see
// src/scripts/conference-timing.ts.
const conferences = orderConferences(
  (await getCollection('conferences')).map((c) => ({
    ...c,
    startMs: c.data.start.getTime(),
    endMs: c.data.end?.getTime(),
  })),
  Date.now(),
);

const stories = (await getCollection('stories'))
  .sort((a, b) => (b.data.episode ?? 0) - (a.data.episode ?? 0))
  .slice(0, 8);

const BSKY_HANDLE = 'virtualddd.com';

// Bluesky feed, fetched at build time from the public API (no auth, no client JS).
// The build must not hang or fail on it: time the request out and warn loudly,
// because a silent failure looks identical to "they haven't posted lately".
interface Post { text: string; date: string; url: string; media?: string; isVideo?: boolean }
let posts: Post[] = [];
try {
  const res = await fetch(
    `https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?actor=${BSKY_HANDLE}&limit=20&filter=posts_no_replies`,
    { signal: AbortSignal.timeout(5000) },
  );
  if (!res.ok) console.warn(`[home] Bluesky feed returned ${res.status}; rendering the follow button instead.`);
  if (res.ok) {
    const data = await res.json();
    posts = (data.feed ?? [])
      .map((f: any) => {
        const p = f.post;
        const rkey = p?.uri?.split('/').pop();
        // Pull a thumbnail from the post's embed (image / video / link card).
        let media: string | undefined;
        let isVideo = false;
        const pick = (e: any) => {
          const t = e?.['$type'];
          if (t === 'app.bsky.embed.video#view') { media = e.thumbnail; isVideo = true; }
          else if (t === 'app.bsky.embed.images#view') { media = e.images?.[0]?.thumb; }
          else if (t === 'app.bsky.embed.external#view') { media = e.external?.thumb; }
          else if (t === 'app.bsky.embed.recordWithMedia#view') { pick(e.media); }
        };
        pick(p?.embed);
        return {
          text: p?.record?.text ?? '',
          date: p?.record?.createdAt ?? '',
          url: `https://bsky.app/profile/${p?.author?.handle}/post/${rkey}`,
          media,
          isVideo,
        };
      })
      .filter((p: Post) => p.text)
      .slice(0, 12);
  }
} catch (err) {
  console.warn(`[home] Bluesky feed unavailable (${err instanceof Error ? err.message : err}); rendering the follow button instead.`);
  posts = [];
}
---

<BaseLayout
  title="Virtual DDD — a community for Domain-Driven Design"
  description="A community-driven platform for deeper knowledge of Domain-Driven Design, software architecture and resilient systems design."
  jsonLd={graph(organization(Astro.site), {
    '@type': 'WebSite',
    '@id': new URL('/#website', Astro.site).toString(),
    name: SITE_NAME,
    description: SITE_TAGLINE,
    url: new URL('/', Astro.site).toString(),
    publisher: { '@id': new URL('/#organization', Astro.site).toString() },
    inLanguage: 'en-GB',
  })}
>
  <div class="wrap">
    <section class="next-section">
      {upcoming.length > 0 && (
        <div class="ns-session">
          {upcoming.map((s, i) => (
            <div class="js-next" data-test="next-session" data-iso={iso(s.data.datetime)} hidden={i !== 0}>
              <FeaturedSession session={s} eyebrow="Upcoming session" />
            </div>
          ))}
        </div>
      )}
      <aside class="ns-about panel-cyan">
        <h1>Learn software &amp; systems design, together.</h1>
        <p>
          A community for people who want to get better at designing software and the systems around
          it. We started with Domain-Driven Design and have widened out since, to whatever helps
          build things that hold up. There is no panel of experts at the front: members bring what
          they have learned, and the rest of us ask awkward questions about it.
        </p>
        <a class="btn btn--ink ns-btn" href="/about-us/">More about us →</a>
      </aside>
    </section>

    <DiscordCard />

    <section class="latest-social">
      <div class="ls-col" data-test="latest-sessions">
        <div class="section-head">
          <h2>Latest sessions</h2>
          <a href="/sessions/">All →</a>
        </div>
        <div class="solo-carousel">
          <div class="solo">
            <div class="solo-track">
              {latest.map((s) => <div class="solo-slide"><SessionCard session={s} /></div>)}
            </div>
          </div>
          <div class="solo-dots">
            {latest.map((_, i) => <button type="button" data-i={i} aria-label={`Session ${i + 1}`}></button>)}
          </div>
        </div>
      </div>

      <div class="ls-col">
        <div class="section-head">
          <h2>Follow us on Bluesky</h2>
          <a href={`https://bsky.app/profile/${BSKY_HANDLE}`}>@{BSKY_HANDLE} →</a>
        </div>
        {posts.length > 0 ? (
          <div class="bfeed">
            {posts.map((p) => (
              <a class="bpost" href={p.url}>
                {p.media && (
                  <div class:list={['bpost-media', { 'is-video': p.isVideo }]}>
                    <img src={p.media} alt="" loading="lazy" />
                  </div>
                )}
                <p class="bpost-text">{p.text}</p>
                <p class="bpost-date">{new Date(p.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
              </a>
            ))}
          </div>
        ) : (
          <p><a class="btn btn--accent" href={`https://bsky.app/profile/${BSKY_HANDLE}`}>Follow @{BSKY_HANDLE}</a></p>
        )}
      </div>
    </section>

    <section class="heur-stories">
      <aside class="hs-col ai-panel panel-cyan">
        <h2>Content creation and AI</h2>
        <p>
          Everything here starts with people talking to each other. A session, a story, an argument
          in Discord that carries on for a week. That is the part we are here for, and it is the part
          nothing can do on our behalf.
        </p>
        <p>
          We do use AI, and we would rather say where than let you wonder. It drafts the written
          version of a story from the transcript, suggests the heuristics we then argue over and
          mostly throw away, and it helped build this site. What it does not do is decide what we
          think.
        </p>
        <p class="ai-claim">The thinking, the opinions and the mistakes are ours.</p>
        <AiUsage class="btn--ink ai-cta" />
      </aside>
      <div class="hs-col">
        <div class="section-head"><h2>Latest stories</h2><a href="/facilitating-archdes/">All →</a></div>
        <div class="solo-carousel">
          <div class="solo">
            <div class="solo-track">
              {stories.map((s) => <div class="solo-slide"><StoryCard story={s} /></div>)}
            </div>
          </div>
          <div class="solo-dots">
            {stories.map((_, i) => <button type="button" data-i={i} aria-label={`Story ${i + 1}`}></button>)}
          </div>
        </div>
      </div>
    </section>

    <section class="heur-row">
      <div class="section-head"><h2>Heuristics</h2><a href="/heuristics/">All →</a></div>
      <div class="heur-links">
        {HEURISTIC_TYPES.map((t) => (
          <a class="tbanner tbanner--compact scrim" href={`/heuristics/${t.key}/`} style={`background-image: url(${t.bg.src})`}>
            <span class="tbanner-body">
              <h3 class="tbanner-title">{t.title} ››</h3>
              <span class="tbanner-text">{t.text}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    {conferences.length > 0 && (
      <section class="home-section">
        <div class="section-head"><h2>Conferences &amp; camps</h2></div>
        <div class="conf-grid" data-test="conferences">
          {conferences.map((c) => <ConferenceCard conference={c} />)}
        </div>
      </section>
    )}

    {team.length > 0 && (
      <section class="home-section">
        <div class="section-head"><h2>Organisers</h2></div>
        <Carousel class="org-carousel" autoplayMs={4000} prevLabel="Previous organisers" nextLabel="More organisers">
          {team.map((o) => <OrganiserCard organiser={o} />)}
        </Carousel>
      </section>
    )}
  </div>

  <style>
    .home-section { margin-block: var(--space-16); }

    /* Next session (3/5) + intro (2/5) */
    .next-section { display: grid; grid-template-columns: 1fr; gap: var(--space-8); margin-block: var(--space-8) 0; align-items: stretch; }
    .next-section > * { min-width: 0; }
    @media (min-width: 900px) { .next-section { grid-template-columns: 3fr 2fr; gap: var(--space-12); } }
    .ns-session { display: flex; flex-direction: column; }
    .ns-session :global(.feat) { flex: 1; margin-bottom: 0; display: flex; }
    .ns-session :global(.feat-card) { flex: 1; }
    /* .panel-cyan / .section-head / .solo-* live in patterns.css. */
    .ns-about h1 { font-size: var(--text-3xl); }
    .ns-about p { margin-bottom: var(--space-6); }

    /* Latest sessions (rotating single card) + Bluesky feed, side by side */
    .latest-social { display: grid; grid-template-columns: 1fr; gap: var(--space-8); margin-block: var(--space-16); align-items: start; }
    .ls-col { min-width: 0; }
    @media (min-width: 900px) { .latest-social { grid-template-columns: 1.1fr 0.9fr; gap: var(--space-12); } }

    .bfeed { display: flex; flex-direction: column; gap: var(--space-3); max-height: 30rem; overflow-y: auto; padding-right: var(--space-2); }
    .bpost { display: block; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: var(--space-4); color: var(--color-text); transition: border-color 0.15s; }
    .bpost:hover { border-color: color-mix(in srgb, var(--color-primary) 55%, var(--color-border)); text-decoration: none; }
    .bpost-media { position: relative; margin-bottom: var(--space-3); overflow: hidden; }
    .bpost-media img { width: 100%; max-height: 190px; object-fit: cover; display: block; }
    .bpost-media.is-video::after { content: '▶'; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; color: #fff; background: rgba(0, 0, 0, 0.3); }
    .bpost-text { margin: 0 0 var(--space-2); font-size: var(--text-sm); line-height: 1.5; white-space: pre-wrap; }
    .bpost-date { margin: 0; font-family: var(--font-heading); color: var(--color-text-muted); font-size: var(--text-sm); }

    /* Heuristics column + latest stories */
    .heur-stories { display: grid; grid-template-columns: 1fr; gap: var(--space-8); margin-block: var(--space-16); align-items: stretch; }
    .hs-col { min-width: 0; display: flex; flex-direction: column; }
    @media (min-width: 900px) { .heur-stories { grid-template-columns: 1fr 1fr; gap: var(--space-12); } }
    /* The three type tiles, side by side under the pair above. Stacked they were
       a column of banners competing with the stories carousel beside them; in a
       row they read as one set of three, which is what they are. The tiles
       themselves come from patterns.css (.tbanner--compact). */
    .heur-row { margin-block: var(--space-16); }
    .heur-links { display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
    @media (min-width: 700px) { .heur-links { grid-template-columns: repeat(3, 1fr); } }
    .heur-links > * { min-width: 0; }

    /* Where the heuristics used to sit: what we use AI for, said plainly, next
       to the stories it helps produce. The panel is not about the tooling; it is
       about the part the tooling cannot do, which is why the claim is the line
       that carries weight and the link is the last thing rather than the first. */
    .ai-panel { justify-content: flex-start; }
    .ai-panel h2 { font-size: var(--text-2xl); }
    .ai-claim { font-weight: 700; color: var(--color-ink); }
    .ai-cta { align-self: flex-start; margin-top: auto; }

    /* Every conference visible, however many there are. A carousel would hide
       one third of a row whose whole purpose is to send people somewhere on a
       date, and the home page already has two things that move on their own.

       One, two, three, then five. Four is skipped on purpose: with five
       conferences it leaves a single card alone on a second row beside three
       empty columns, which is the layout this replaced. Three gives 3 + 2,
       which reads as deliberate. `auto-fit` was tried first and is worse — it
       lands on four for every width between about 900px and 1130px.

       At 72rem, where the container stops growing, five sit at about 205px
       each: the width the organiser cards below already use. The number here
       is the one thing that will need changing when a sixth conference is
       added, and it wants to become six or three rather than five. */
    .conf-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
    @media (min-width: 40rem) { .conf-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 56rem) { .conf-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (min-width: 72rem) { .conf-grid { grid-template-columns: repeat(5, 1fr); } }
    .conf-grid > * { min-width: 0; }

    /* Organiser cards sit a little narrower than the carousel default. */
    .org-carousel :global(.carousel > *) { flex: 0 0 clamp(200px, 42%, 250px); }

  </style>

  <script>
    document.querySelectorAll<HTMLElement>('.solo-carousel').forEach((car) => {
      const track = car.querySelector<HTMLElement>('.solo-track');
      const dots = Array.from(car.querySelectorAll<HTMLButtonElement>('.solo-dots button'));
      if (!track) return;
      const n = track.children.length;
      if (!n) return;
      let i = 0;
      let timer: ReturnType<typeof setInterval>;
      const set = (k: number) => {
        i = (k + n) % n;
        track.style.transform = `translateX(-${i * 100}%)`;
        dots.forEach((d, j) => d.classList.toggle('on', j === i));
      };
      const start = () => { timer = setInterval(() => set(i + 1), 10000); };
      const stop = () => clearInterval(timer);
      dots.forEach((d) => d.addEventListener('click', () => { stop(); set(Number(d.dataset.i)); start(); }));
      car.addEventListener('mouseenter', stop);
      car.addEventListener('mouseleave', start);
      set(0);
      start();
    });

    // The organiser carousel shuffles on every load so no one is always first.
    const oc = document.querySelector<HTMLElement>('.org-carousel .carousel');
    if (oc) {
      const cards = Array.from(oc.children);
      for (let k = cards.length - 1; k > 0; k--) {
        const j = Math.floor(Math.random() * (k + 1));
        [cards[k], cards[j]] = [cards[j], cards[k]];
      }
      cards.forEach((c) => oc.appendChild(c));
    }
  </script>
</BaseLayout>
