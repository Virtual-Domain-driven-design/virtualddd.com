---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedSession from '../components/FeaturedSession.astro';
import SessionCard from '../components/SessionCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const now = Date.now();
const allSessions = await getCollection('sessions');
const upcoming = allSessions
  .filter((s) => s.data.status === 'Published' && +new Date(s.data.datetime) > now)
  .sort((a, b) => +new Date(a.data.datetime) - +new Date(b.data.datetime))[0];
const latest = [...allSessions]
  .sort((a, b) => +new Date(b.data.datetime) - +new Date(a.data.datetime))
  .slice(0, 8);
const team = (await getCollection('organisers')).filter((o) => o.data.showOnTeam);

const explore = [
  { href: '/sessions/', title: 'Online sessions', text: 'Live meetups — talks, debates, fireside chats and hands-on modelling.' },
  { href: '/open-space/', title: 'Open Space', text: 'Participant-led gatherings where the agenda emerges from the room.' },
  { href: '/facilitating-archdes/', title: 'Facilitating Stories', text: 'Real stories on facilitating software architecture & design.' },
  { href: '/heuristics/', title: 'Heuristics', text: 'Curated rules of thumb for designing better software and systems.' },
];
const DISCORD = 'https://discord.gg/tRJkcsFDKN';
const BSKY_HANDLE = 'virtualddd.com';

// Bluesky feed, fetched at build time from the public API (no auth, no client JS).
interface Post { text: string; date: string; url: string }
let posts: Post[] = [];
try {
  const res = await fetch(
    `https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?actor=${BSKY_HANDLE}&limit=20&filter=posts_no_replies`,
  );
  if (res.ok) {
    const data = await res.json();
    posts = (data.feed ?? [])
      .map((f: any) => {
        const p = f.post;
        const rkey = p?.uri?.split('/').pop();
        return {
          text: p?.record?.text ?? '',
          date: p?.record?.createdAt ?? '',
          url: `https://bsky.app/profile/${p?.author?.handle}/post/${rkey}`,
        };
      })
      .filter((p: Post) => p.text)
      .slice(0, 12);
  }
} catch {
  posts = [];
}
---

<BaseLayout
  title="Virtual DDD — a community for Domain-Driven Design"
  description="A community-driven platform for deeper knowledge of Domain-Driven Design, software architecture and resilient systems design."
>
  <section class="home-hero">
    <div class="wrap">
      <h1>Learn software &amp; systems design, together.</h1>
      <p class="home-lead">
        Virtual DDD is a community-driven platform for people who want deeper knowledge of
        Domain-Driven Design, software architecture, and resilient systems — through live online
        sessions, open spaces, and shared heuristics.
      </p>
      <div class="hero-cta">
        <a class="btn btn--accent" href={DISCORD}>Join our Discord</a>
        <a class="btn" href="/sessions/">Explore sessions</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    {upcoming && <FeaturedSession session={upcoming} eyebrow="Next session" />}

    <section class="latest-social">
      <div class="ls-col">
        <div class="section-head">
          <h2>Latest sessions</h2>
          <a href="/sessions/">All →</a>
        </div>
        <div class="solo" id="solo">
          <div class="solo-track">
            {latest.map((s) => <div class="solo-slide"><SessionCard session={s} /></div>)}
          </div>
        </div>
        <div class="solo-dots" id="solo-dots">
          {latest.map((_, i) => <button type="button" data-i={i} aria-label={`Session ${i + 1}`}></button>)}
        </div>
      </div>

      <div class="ls-col">
        <div class="section-head">
          <h2>Follow us on Bluesky</h2>
          <a href={`https://bsky.app/profile/${BSKY_HANDLE}`}>@{BSKY_HANDLE} →</a>
        </div>
        {posts.length > 0 ? (
          <div class="bfeed">
            {posts.map((p) => (
              <a class="bpost" href={p.url}>
                <p class="bpost-text">{p.text}</p>
                <p class="bpost-date">{new Date(p.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</p>
              </a>
            ))}
          </div>
        ) : (
          <p><a class="btn btn--accent" href={`https://bsky.app/profile/${BSKY_HANDLE}`}>Follow @{BSKY_HANDLE}</a></p>
        )}
      </div>
    </section>

    <section class="home-section">
      <h2>Explore</h2>
      <div class="explore-grid">
        {explore.map((e) => (
          <a class="explore" href={e.href}>
            <h3>{e.title}</h3>
            <p>{e.text}</p>
            <span class="explore-arrow">→</span>
          </a>
        ))}
      </div>
    </section>

    {team.length > 0 && (
      <section class="home-section">
        <h2>The organisers</h2>
        <div class="team-grid">
          {team.map((o) => (
            <div class="team-card">
              {o.data.photo && <Image class="team-photo" src={o.data.photo} alt={o.data.name} width={160} />}
              <p class="team-name">{o.data.name}</p>
              {o.data.role && <p class="team-role">{o.data.role}</p>}
              <p class="team-links">
                {o.data.website && <a href={o.data.website}>Web</a>}
                {o.data.linkedin && <a href={o.data.linkedin}>LinkedIn</a>}
                {o.data.twitter && <a href={o.data.twitter}>Twitter</a>}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>

  <section class="discord-band">
    <div class="wrap">
      <h2>Join the conversation</h2>
      <p>The community lives on Discord — talks, questions and connections all week long.</p>
      <a class="btn discord-btn" href={DISCORD}>Join our Discord</a>
    </div>
  </section>

  <style>
    .home-hero { background: radial-gradient(120% 140% at 15% 0%, color-mix(in srgb, var(--color-primary) 22%, var(--color-bg)), var(--color-bg) 60%); padding-block: var(--space-16); margin-top: calc(-1 * var(--space-12)); }
    .home-hero h1 { font-size: clamp(2.4rem, 6vw, var(--text-4xl)); max-width: 18ch; }
    .home-lead { font-size: var(--text-lg); color: var(--color-text-muted); max-width: 46rem; margin-block: var(--space-4) var(--space-6); }
    .hero-cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }

    .home-section { margin-block: var(--space-16); }
    .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-6); }
    .section-head h2 { margin: 0; }
    .section-head a { font-family: var(--font-heading); font-weight: 600; }

    /* Latest sessions (rotating single card) + Bluesky feed, side by side */
    .latest-social { display: grid; grid-template-columns: 1fr; gap: var(--space-8); margin-block: var(--space-16); align-items: start; }
    .ls-col { min-width: 0; }
    @media (min-width: 900px) { .latest-social { grid-template-columns: 1.1fr 0.9fr; gap: var(--space-12); } }

    .solo { overflow: hidden; border-radius: var(--radius); }
    .solo-track { display: flex; transition: transform 0.5s ease; }
    .solo-slide { flex: 0 0 100%; min-width: 0; }
    .solo-dots { display: flex; gap: var(--space-2); margin-top: var(--space-4); }
    .solo-dots button { width: 8px; height: 8px; border-radius: 50%; border: 0; background: var(--color-border); cursor: pointer; padding: 0; transition: width 0.2s, background 0.2s; }
    .solo-dots button.on { background: var(--color-primary); width: 22px; border-radius: 4px; }

    .bfeed { display: flex; flex-direction: column; gap: var(--space-3); max-height: 30rem; overflow-y: auto; padding-right: var(--space-2); }
    .bpost { display: block; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: var(--space-4); color: var(--color-text); transition: border-color 0.15s; }
    .bpost:hover { border-color: color-mix(in srgb, var(--color-primary) 55%, var(--color-border)); text-decoration: none; }
    .bpost-text { margin: 0 0 var(--space-2); font-size: var(--text-sm); line-height: 1.5; white-space: pre-wrap; }
    .bpost-date { margin: 0; font-family: var(--font-heading); color: var(--color-text-muted); font-size: var(--text-sm); }

    .explore-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
    .explore { position: relative; display: block; background: var(--color-surface); border-radius: var(--radius); padding: var(--space-6); color: var(--color-text); border: 1px solid transparent; transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s; }
    .explore:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: color-mix(in srgb, var(--color-primary) 55%, var(--color-border)); text-decoration: none; }
    .explore h3 { margin: 0 0 var(--space-2); }
    .explore p { margin: 0; color: var(--color-text-muted); font-size: var(--text-sm); }
    .explore-arrow { color: var(--color-primary); font-family: var(--font-heading); font-weight: 700; position: absolute; top: var(--space-4); right: var(--space-6); }

    .team-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--space-6); }
    .team-card { text-align: center; }
    .team-photo { width: 110px; height: 110px; border-radius: 50%; object-fit: cover; margin: 0 auto var(--space-3); box-shadow: var(--shadow); }
    .team-name { font-family: var(--font-heading); font-weight: 600; margin: 0; }
    .team-role { color: var(--color-accent-dark); font-size: var(--text-sm); margin: 0 0 var(--space-2); }
    .team-links { display: flex; justify-content: center; gap: var(--space-3); font-size: var(--text-sm); margin: 0; }

    .discord-band { background: var(--color-accent); color: #fff; text-align: center; padding-block: var(--space-16); margin-top: var(--space-16); }
    .discord-band h2 { color: #fff; margin: 0 0 var(--space-2); }
    .discord-band p { margin: 0 0 var(--space-6); opacity: 0.95; }
    .discord-btn { background: #fff; color: #c53d84; border-color: #fff; }
    .discord-btn:hover { background: rgba(255, 255, 255, 0.9); border-color: rgba(255, 255, 255, 0.9); color: #b83b7f; }
  </style>

  <script>
    const solo = document.getElementById('solo');
    const track = solo?.querySelector('.solo-track') as HTMLElement | null;
    const dots = Array.from(document.querySelectorAll('#solo-dots button')) as HTMLButtonElement[];
    if (solo && track) {
      const n = track.children.length;
      let i = 0;
      let timer: ReturnType<typeof setInterval>;
      const set = (k: number) => {
        i = (k + n) % n;
        track.style.transform = `translateX(-${i * 100}%)`;
        dots.forEach((d, j) => d.classList.toggle('on', j === i));
      };
      const start = () => { timer = setInterval(() => set(i + 1), 10000); };
      const stop = () => clearInterval(timer);
      dots.forEach((d) => d.addEventListener('click', () => { stop(); set(Number(d.dataset.i)); start(); }));
      solo.addEventListener('mouseenter', stop);
      solo.addEventListener('mouseleave', start);
      set(0);
      start();
    }
  </script>
</BaseLayout>
