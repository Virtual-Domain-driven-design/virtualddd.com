---
import { Image } from 'astro:assets';
import Socials from './Socials.astro';

interface LatestItem {
  href: string;
  title: string;
  img?: ImageMetadata;
  iso?: string;
  fallback?: string;
}
interface Props {
  latest?: LatestItem[];
  latestLabel: string;
  latestAllHref: string;
}
const { latest = [], latestLabel, latestAllHref } = Astro.props;

const DISCORD = 'https://discord.gg/tRJkcsFDKN';
const DISCORD_PATH =
  'M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z';
---

<div class="side-block side-discord">
  <h2 class="eyebrow eyebrow--cyan">Community</h2>
  <div class="sd-head">
    <span class="sd-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26"><path fill="currentColor" d={DISCORD_PATH} /></svg>
    </span>
    <p class="sd-title">Join our Discord community</p>
  </div>
  <p class="sd-text">Talks, questions and connections all week long.</p>
  <a class="btn btn--block" href={DISCORD}>Join Discord ↗</a>
</div>

<div class="side-block">
  <h2 class="eyebrow eyebrow--cyan">Follow us</h2>
  <Socials />
</div>

<!-- How this site is made, rather than what it says. Its own block: under
     Follow us it read as another way to follow us, which is the opposite of
     what it is. It used to be the only call to action on the Facilitating
     Stories page, where it competed with the stories themselves. -->
<div class="side-block">
  <h2 class="eyebrow eyebrow--cyan">How this site is made</h2>
  <a class="btn btn--accent btn--block side-ai" href="/ai-usage-on-this-site/">Read more on our AI usage →</a>
</div>

{latest.length > 0 && (
  <div class="side-block">
    <h2 class="eyebrow eyebrow--cyan">{latestLabel}</h2>
    <ul class="side-latest">
      {latest.map((i) => (
        <li>
          <a href={i.href}>
            {i.img && <Image src={i.img} alt="" width={112} height={63} />}
            <span class="sl-text">
              {i.iso && (
                <time class="js-local sl-date" data-format="shortdate" datetime={i.iso} data-iso={i.iso}>{i.fallback}</time>
              )}
              <span class="sl-title">{i.title}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <a class="sl-all" href={latestAllHref}>View all →</a>
  </div>
)}

<style>
  .side-block { margin-top: var(--space-8); }
  /* Clear of its own heading. */
  .side-ai { margin-top: var(--space-3); }

  /* Discord — consistent with the other sidebar blocks (dark, cyan accents) */
  .sd-head { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-2); }
  .sd-icon { display: inline-flex; color: var(--color-primary); flex: none; }
  .sd-title { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); line-height: 1.15; margin: 0; }
  .sd-text { color: var(--color-text-muted); font-size: var(--text-sm); margin: 0 0 var(--space-4); }

  /* Latest list */
  .side-latest { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .side-latest a { display: flex; gap: var(--space-3); align-items: center; color: var(--color-text); }
  .side-latest a:hover { text-decoration: none; }
  .side-latest a:hover .sl-title { color: var(--color-primary); }
  .side-latest :global(img) { width: 112px; height: 63px; object-fit: cover; flex: none; }
  .sl-text { display: flex; flex-direction: column; min-width: 0; }
  .sl-date { font-family: var(--font-heading); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); font-size: 0.72rem; }
  .sl-title { font-size: var(--text-sm); line-height: 1.25; transition: color 0.15s; }
  .sl-all { display: inline-block; margin-top: var(--space-4); font-family: var(--font-heading); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; font-size: var(--text-sm); }
</style>
