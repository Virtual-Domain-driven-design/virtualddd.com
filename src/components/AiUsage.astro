---
/** The link to how this site uses AI, in the two shapes the site needs.
 *
 * One component because it appeared in three places with three labels and only
 * one of them had the icon: a full-width pink banner on the about page, a
 * button in the sidebar of every detail page, and a button in the blue panel on
 * the home page. A reader who meets it twice should recognise it the second
 * time, which means the same icon and the same words in every one.
 *
 * `variant="banner"` is the wide version with a subtitle, for the foot of a
 * page. The default is a button, and `class` carries whatever button treatment
 * the surface it sits on needs: the accent on a dark sidebar, ink on the cyan
 * panel, since a button has to read against what is behind it.
 */
interface Props {
  variant?: 'banner' | 'button';
  /** Extra classes for the button variant, e.g. `btn--ink` or `btn--block`. */
  class?: string;
}
const { variant = 'button', class: className = '' } = Astro.props;

const HREF = '/ai-usage-on-this-site/';
const TITLE = 'AI usage on this site';
const SUB = "How we do and don't use AI.";
// A spark, not a robot: the page is about our judgement, not the machine's.
const SPARK =
  'M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z';
---

{variant === 'banner' ? (
  <a class="ai-banner" href={HREF}>
    <span class="aib-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="30" height="30"><path fill="currentColor" d={SPARK} /></svg>
    </span>
    <span class="aib-text">
      <span class="aib-title">{TITLE}</span>
      <span class="aib-sub">{SUB}</span>
    </span>
    <span class="btn btn--inverse aib-btn">Read more →</span>
  </a>
) : (
  <a class:list={['btn', 'ai-btn', className]} href={HREF}>
    <span class="ai-btn-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d={SPARK} /></svg>
    </span>
    <span>{TITLE} →</span>
  </a>
)}

<style>
  /* Banner: the wide version, for the foot of a page. */
  .ai-banner { display: flex; align-items: center; gap: var(--space-6); background: var(--color-accent); color: var(--on-brand); padding: var(--space-6) var(--space-8); }
  .ai-banner:hover { text-decoration: none; }
  .aib-icon { flex: none; display: inline-flex; }
  .aib-text { flex: 1 1 auto; display: flex; flex-direction: column; }
  .aib-title { font-family: var(--font-heading); font-weight: 700; font-size: var(--text-xl); }
  .aib-sub { color: var(--color-ink-muted); font-size: var(--text-sm); }
  .aib-btn { flex: none; }
  @media (max-width: 639.98px) { .ai-banner { flex-wrap: wrap; text-align: center; justify-content: center; } .aib-text { flex-basis: 100%; } }

  /* Button: the same icon at the size a button can carry, so the two read as
     the same thing rather than two links that happen to share a destination. */
  .ai-btn { display: inline-flex; align-items: center; gap: var(--space-2); text-align: left; }
  .ai-btn-icon { flex: none; display: inline-flex; }
</style>
