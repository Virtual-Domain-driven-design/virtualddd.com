---
import type { CollectionEntry } from 'astro:content';
import TeaserCard from './TeaserCard.astro';
import { iso, shortDate } from '../lib/dates';
import { packFacet } from '../lib/card-filter';

interface Props {
  session: CollectionEntry<'sessions'>;
}
const { session } = Astro.props;
const d = session.data;

// All three levels means "come as you are" — say that rather than listing them.
const LEVELS = 3;
const level = d.level.length === LEVELS ? 'All levels' : d.level.join(', ');
---

<TeaserCard
  href={`/sessions/${session.id}/`}
  title={d.title}
  img={d.featuredImage}
  badge={d.typeOfSession}
  iso={iso(d.datetime)}
  dateFallback={shortDate(d.datetime)}
  metaSuffix={level || undefined}
  sub={d.organiser ? `Hosted by ${d.organiser}` : undefined}
  data={{
    search: [d.title, d.organiser ?? '', ...d.tags].join(' ').toLowerCase(),
    tags: packFacet(d.tags),
    level: packFacet(d.level ?? []),
    type: packFacet([d.typeOfSession ?? '']),
  }}
/>
