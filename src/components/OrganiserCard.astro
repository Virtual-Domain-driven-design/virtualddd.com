---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { profileLinks } from '../lib/people';

interface Props {
  organiser: CollectionEntry<'organisers'>;
  /** Link the card to the organiser's page. Rendered as a stretched link over
   *  the name rather than a wrapper, because the card already contains links
   *  and anchors cannot nest. */
  href?: string;
}
const { organiser, href } = Astro.props;
const d = organiser.data;

// Keyed by the labels `profileLinks` uses, so the card cannot end up holding an
// opinion about which profiles a person has, or what order they come in. A
// label with no icon here simply does not appear on the card; the organiser's
// own page lists it in full.
const ICONS: Record<string, string> = {
  Website: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z',
  LinkedIn: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z',
  Mastodon: 'M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.669 1.977v6.218H4.822V8.102c0-1.31.336-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.01 1.81 1.01 3.12z',
  Bluesky: 'M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z',
};
const links = profileLinks(d)
  .filter((l) => ICONS[l.label])
  .map((l) => ({ ...l, path: ICONS[l.label] }));
---

<div class="org-card" data-pagefind-ignore>
  <div class="org-photo">
    {d.photo ? <Image src={d.photo} alt={d.name} width={320} /> : <div class="org-ph"></div>}
  </div>
  <div class="org-body">
    <p class="org-name">{href ? <a class="org-stretch" href={href}>{d.name}</a> : d.name}</p>
    {d.role && <p class="org-role">{d.role}</p>}
    {links.length > 0 && (
      <div class="org-icons">
        {links.map((l) => (
          <a href={l.href} aria-label={`${d.name} — ${l.label}`} title={l.label}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d={l.path} /></svg>
          </a>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .org-card { position: relative; display: flex; flex-direction: column; background: var(--color-surface); border: 1px solid var(--color-border); height: 100%; }
  .org-photo { aspect-ratio: 1 / 1; background: var(--color-surface-2); }
  .org-photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .org-ph { width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-primary), var(--color-accent)); }
  .org-body { padding: var(--space-4) var(--space-5) var(--space-5); }
  .org-name { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); margin: 0; }
  .org-role { color: var(--color-text-muted); font-size: var(--text-sm); margin: var(--space-1) 0 var(--space-3); }
  .org-icons { display: flex; gap: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--color-border); color: var(--color-primary); }
  /* The stretched link covers the card; the social icons sit above it. */
  .org-stretch { color: inherit; }
  .org-stretch::after { content: ''; position: absolute; inset: 0; }
  .org-stretch:hover { color: var(--color-primary); text-decoration: none; }
  .org-icons { position: relative; }
  /* 24px minimum target around a 20px icon (WCAG 2.5.8). */
  .org-icons a { color: var(--color-primary); display: inline-flex; align-items: center;
    justify-content: center; min-width: 24px; min-height: 24px; }
  .org-icons a:hover { color: var(--color-primary-dark); }
</style>
