---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  session: CollectionEntry<'sessions'>;
  eyebrow?: string;
}
const { session, eyebrow } = Astro.props;
const d = session.data;
const dateStr = new Date(d.datetime).toLocaleString('en-GB', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short',
});
---

<section class="feat">
  {eyebrow && <p class="feat-eyebrow">{eyebrow}</p>}
  <div class="feat-card">
    <div class="feat-img">
      {d.featuredImage ? <Image src={d.featuredImage} alt="" width={720} /> : <div class="feat-ph"></div>}
    </div>
    <div class="feat-body">
      <div class="badges">
        {d.typeOfSession && <span class="badge badge--type">{d.typeOfSession}</span>}
        {d.level?.map((l) => <span class="badge">{l}</span>)}
      </div>
      <h2><a href={`/sessions/${session.id}/`}>{d.title}</a></h2>
      <p class="feat-date">{dateStr}</p>
      {d.organiser && <p class="feat-host">Hosted by {d.organiser}</p>}
      <div class="feat-cta">
        {(d.humantix || d.meet) && <a class="btn btn--accent" href={d.humantix ?? d.meet}>RSVP to attend</a>}
        {d.meet && <a class="btn btn--ghost" href={d.meet}>Google Meet</a>}
        <a class="btn" href={`/sessions/${session.id}/`}>More info →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .feat { margin-bottom: var(--space-16); container-type: inline-size; }
  .feat-eyebrow { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-accent-dark); margin: 0 0 var(--space-3); }
  .feat-card { display: grid; grid-template-columns: 1fr; background: var(--color-surface); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  .feat-img { aspect-ratio: 16 / 9; }
  .feat-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .feat-ph { width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-primary), var(--color-accent)); }
  .feat-body { padding: var(--space-8); }
  .feat-body .badges { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-3); }
  .feat-body h2 { font-size: var(--text-3xl); margin: 0 0 var(--space-3); }
  .feat-body h2 a { color: var(--color-text); }
  .feat-date { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); margin: 0 0 var(--space-1); }
  .feat-host { color: var(--color-text-muted); margin: 0 0 var(--space-6); }
  .feat-cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  @container (min-width: 46rem) {
    .feat-card { grid-template-columns: 1.1fr 1fr; }
    .feat-img { aspect-ratio: auto; }
  }
</style>
