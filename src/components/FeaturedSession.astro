---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  session: CollectionEntry<'sessions'>;
  eyebrow?: string;
}
const { session, eyebrow } = Astro.props;
const d = session.data;
const iso = new Date(d.datetime).toISOString();
// Server fallback (replaced client-side with the visitor's local time).
const fallback = new Date(d.datetime).toLocaleString('en-GB', {
  weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit',
});
---

<section class="feat">
  <div class="feat-card">
    <div class="feat-media">
      {d.featuredImage ? <Image src={d.featuredImage} alt="" width={900} /> : <div class="feat-ph"></div>}
    </div>
    <div class="feat-overlay">
      {eyebrow && <span class="feat-label">{eyebrow}</span>}
      <div class="feat-content">
        <h2><a href={`/sessions/${session.id}/`}>{d.title}</a></h2>
        <p class="feat-when"><time class="js-local" data-format="datetime" datetime={iso} data-iso={iso}>{fallback}</time></p>
        <p class="feat-countdown js-countdown" data-iso={iso}></p>
        <div class="feat-cta">
          {d.humantix
            ? <a class="btn btn--accent" href={d.humantix}>RSVP</a>
            : <a class="btn btn--accent" href={`/sessions/${session.id}/`}>More info →</a>}
          {d.humantix && <a class="btn btn--ghost" href={`/sessions/${session.id}/`}>More info →</a>}
        </div>

        {(d.meet || d.video) && (
          /* Joining is only actionable near the start. Rendered visible so a
             no-JS visitor still gets the links; the script hides them until
             two hours before, which is when RSVP stops being the point. */
          <div class="feat-live js-live" data-iso={iso}>
            <span class="feat-live-label">Starting soon</span>
            {d.meet && <a class="btn" href={d.meet}>Join Google Meet</a>}
            {d.video && <a class="btn btn--ghost" href={d.video}>Watch livestream</a>}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .feat { margin-bottom: var(--space-16); }
  .feat-card { position: relative; overflow: hidden; min-height: 30rem; display: flex; box-shadow: var(--shadow); background: var(--color-surface); }
  .feat-media { position: absolute; inset: 0; }
  .feat-media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .feat-ph { width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-primary), var(--color-accent)); }
  .feat-overlay {
    position: relative; z-index: 1; width: 100%;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: var(--space-8) var(--space-6) var(--space-6);
    background:
      linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.55) 55%, rgba(0, 0, 0, 0.2) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.55) 55%, rgba(0, 0, 0, 0.15) 100%);
  }
  .feat-label { position: absolute; top: var(--space-4); left: var(--space-4); z-index: 2; background: var(--color-accent); color: #fff; font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--text-sm); padding: 0.3em 0.8em; }

  .feat-content { max-width: 42ch; }
  .feat-content h2 { font-size: var(--text-3xl); line-height: 1.1; margin: 0 0 var(--space-4); text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6); }
  .feat-content h2 a { color: #fff; }
  .feat-when { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-lg); margin: 0 0 var(--space-1); color: var(--color-accent-dark); }
  .feat-countdown { font-family: var(--font-heading); font-weight: 700; color: var(--color-primary); margin: 0 0 var(--space-6); letter-spacing: 0.03em; }
  .feat-countdown:empty { display: none; }
  .feat-cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .feat-live { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-4); }
  .feat-live-label {
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; font-size: var(--text-sm); color: var(--color-primary);
  }
</style>
