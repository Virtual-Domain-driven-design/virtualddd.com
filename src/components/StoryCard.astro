---
import type { CollectionEntry } from 'astro:content';
import TeaserCard from './TeaserCard.astro';
import { iso, shortDate } from '../lib/dates';
import { storyCredits } from '../lib/collections';

interface Props {
  story: CollectionEntry<'stories'>;
}
const { story } = Astro.props;
const d = story.data;
const credits = await storyCredits(d);
const authors = credits.slice(0, 3).join(', ') + (credits.length > 3 ? ' & more' : '');
---

<TeaserCard
  href={`/facilitating-archdes/${story.id}/`}
  title={d.title}
  img={d.featuredImage ?? d.featuredImageSquared}
  badge={d.episode != null ? `Ep ${d.episode}` : undefined}
  iso={d.publishedDate ? iso(d.publishedDate) : undefined}
  dateFallback={d.publishedDate ? shortDate(d.publishedDate) : undefined}
  sub={credits.length > 0 ? authors : undefined}
/>
