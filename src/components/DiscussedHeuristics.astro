---
import type { CollectionEntry } from 'astro:content';

interface Props {
  heuristics: CollectionEntry<'heuristics'>[];
}
const { heuristics } = Astro.props;
---

{heuristics.length > 0 && (
  <section class="dh">
    <p class="eyebrow eyebrow--cyan">Discussed heuristics</p>
    <div class="dh-wrap">
      <button class="dh-arrow dh-prev" type="button" aria-label="Previous heuristics">‹</button>
      <div class="dh-carousel">
        {heuristics.map((h) => (
          <a class="dh-card" href={`/heuristics/${h.id}/`}>
            {h.data.question && <p class="dh-q">{h.data.question}</p>}
            <h3 class="dh-title">{h.data.title}</h3>
            <span class="dh-more">More info →</span>
          </a>
        ))}
      </div>
      <button class="dh-arrow dh-next" type="button" aria-label="More heuristics">›</button>
    </div>
  </section>
)}

<style>
  .dh { margin-top: var(--space-16); }
  .eyebrow { display: inline-flex; align-items: center; gap: var(--space-3); font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--text-sm); color: var(--color-primary); margin: 0 0 var(--space-6); }
  .eyebrow::before { content: ''; width: 1.75rem; height: 2px; background: var(--color-primary); }

  .dh-wrap { position: relative; }
  .dh-carousel { display: flex; gap: var(--space-4); overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; padding-bottom: var(--space-2); }
  .dh-carousel::-webkit-scrollbar { display: none; }

  /* White heuristic cards, matching the brand's heuristic styling */
  .dh-card { flex: 0 0 clamp(240px, 46%, 320px); scroll-snap-align: start; display: flex; flex-direction: column; background: #fff; color: #0d0e12; padding: var(--space-6); min-height: 12rem; transition: transform 0.15s, box-shadow 0.15s; }
  .dh-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); text-decoration: none; }
  .dh-q { color: #0b7f9e; font-size: var(--text-sm); line-height: 1.4; margin: 0 0 var(--space-3); }
  .dh-title { color: #0d0e12; font-size: var(--text-lg); line-height: 1.2; margin: 0; }
  .dh-more { margin-top: auto; padding-top: var(--space-4); font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: var(--text-sm); color: #0b7f9e; }

  .dh-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 44px; height: 44px; border: 1px solid var(--color-border); background: color-mix(in srgb, var(--color-surface) 90%, transparent); color: var(--color-text); font-size: var(--text-2xl); line-height: 1; cursor: pointer; display: none; }
  .dh-arrow:hover { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  .dh-prev { left: calc(-1 * var(--space-5)); }
  .dh-next { right: calc(-1 * var(--space-5)); }
  @media (min-width: 800px) { .dh-arrow { display: block; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.dh-wrap').forEach((wrap) => {
    const car = wrap.querySelector<HTMLElement>('.dh-carousel');
    if (!car) return;
    const step = () => {
      const card = car.querySelector<HTMLElement>('.dh-card');
      return card ? card.getBoundingClientRect().width + 16 : 260;
    };
    const next = () => {
      if (car.scrollLeft + car.clientWidth >= car.scrollWidth - 6) car.scrollTo({ left: 0, behavior: 'smooth' });
      else car.scrollBy({ left: step(), behavior: 'smooth' });
    };
    const prev = () => car.scrollBy({ left: -step(), behavior: 'smooth' });
    let timer: ReturnType<typeof setInterval>;
    const start = () => { if (car.scrollWidth > car.clientWidth + 6) timer = setInterval(next, 5000); };
    const stop = () => clearInterval(timer);
    wrap.querySelector('.dh-next')?.addEventListener('click', () => { stop(); next(); start(); });
    wrap.querySelector('.dh-prev')?.addEventListener('click', () => { stop(); prev(); start(); });
    car.addEventListener('mouseenter', stop);
    car.addEventListener('mouseleave', start);
    start();
  });
</script>
