---
import type { CollectionEntry } from 'astro:content';
import Carousel from './Carousel.astro';
import HeuristicCard from './HeuristicCard.astro';

interface Props {
  heuristics: CollectionEntry<'heuristics'>[];
}
const { heuristics } = Astro.props;
---

{heuristics.length > 0 && (
  <Carousel
    class="stack-top"
    eyebrow="Discussed heuristics"
    autoplayMs={5000}
    prevLabel="Previous heuristics"
    nextLabel="More heuristics"
  >
    {heuristics.map((h) => <HeuristicCard heuristic={h} />)}
  </Carousel>
)}
