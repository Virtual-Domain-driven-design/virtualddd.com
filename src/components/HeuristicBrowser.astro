---
import HeuristicCard from './HeuristicCard.astro';
import type { CollectionEntry } from 'astro:content';
import { HEURISTIC_TYPES } from '../lib/heuristics';
import { tagOptions } from '../lib/collections';

interface Props {
  items: CollectionEntry<'heuristics'>[];
  /** Show the three type banners, which double as the type filter. */
  showBanners?: boolean;
}
const { items, showBanners = false } = Astro.props;

const tags = tagOptions(items);

// Counts come from the items in hand, so a filtered browser stays honest.
const banners = showBanners
  ? HEURISTIC_TYPES.map((t) => ({ ...t, count: items.filter((h) => h.data.type[0] === t.key).length }))
  : [];
---

<div class="hb">
  {banners.length > 0 && (
    <div class="hb-banners" id="hb-banners" role="group" aria-label="Filter by heuristic type">
      {banners.map((t) => (
        <button type="button" class="hb-banner scrim" data-type={t.key} style={`background-image: url(${t.bg.src})`}>
          <span class="hbn-body">
            <span class="hbn-title">{t.title}</span>
            <span class="hbn-text">{t.text}</span>
            <span class="hbn-count">{t.count} heuristics</span>
          </span>
        </button>
      ))}
    </div>
  )}

  <div class="filters hb-filters">
    <input type="search" id="hq" placeholder="Search heuristics…" aria-label="Search heuristics" />
    <select id="hf-tag" aria-label="Filter by tag">
      <option value="">All tags</option>
      {tags.map((t) => <option value={t}>{t}</option>)}
    </select>
    <button id="hf-reset" class="filter-reset" type="button">Reset</button>
    <span class="result-count" id="hb-count"></span>
  </div>

  <div class="grid-cards" id="h-cards">
    {items.map((h) => <HeuristicCard heuristic={h} />)}
  </div>
  <p class="no-results" id="hb-none" hidden>No heuristics match your filters.</p>
  <div class="hb-load"><button id="hb-more" type="button" class="btn btn--ghost">Load more</button></div>
</div>

<style>
  /* Type banners double as the type filter */
  .hb-banners { display: grid; grid-template-columns: 1fr; gap: var(--space-6); margin-bottom: var(--space-8); }
  @media (min-width: 800px) { .hb-banners { grid-template-columns: repeat(3, 1fr); } }
  /* .scrim (patterns.css) supplies the overlay; these read top-down, and match
     the same tiles on /ddd-heuristics/ and the home page. */
  .hb-banner { display: flex; min-height: 12rem; padding: var(--space-6); text-align: left; color: #fff; border: 0; cursor: pointer; transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s; }
  .hb-banner::before { background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.8) 100%); transition: background 0.15s; }
  .hb-banner:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .hbn-body { position: relative; z-index: 1; margin-top: auto; }
  .hbn-title { display: block; font-family: var(--font-heading); font-weight: 700; font-size: var(--text-xl); text-shadow: 0 1px 8px rgba(0,0,0,0.6); }
  .hbn-text { display: block; color: rgba(255,255,255,0.92); margin: var(--space-2) 0 var(--space-3); font-size: var(--text-sm); }
  .hbn-count { display: block; font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: var(--text-sm); color: var(--color-primary-dark); }
  .hb-banner.active { outline: 3px solid var(--color-primary); outline-offset: -3px; }
  .hb-banner.active::before { background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.7) 100%); }
  .hb-banners.has-active .hb-banner:not(.active) { opacity: 0.5; }

  /* Filters, the card grid and the result count come from patterns.css. */
  .hb-filters { margin: 0 0 var(--space-8); }
  .result-count { margin-left: auto; }
  .grid-cards { --card-min: 16.25rem; }
  .hb-load { text-align: center; margin-top: var(--space-8); }
</style>

<script>
  import { applyUrlFilter } from '../lib/filter-url';

  const cards = Array.from(document.querySelectorAll<HTMLElement>('#h-cards .card'));
  const q = document.getElementById('hq') as HTMLInputElement;
  const fTag = document.getElementById('hf-tag') as HTMLSelectElement;
  const reset = document.getElementById('hf-reset') as HTMLButtonElement;
  const count = document.getElementById('hb-count') as HTMLElement;
  const none = document.getElementById('hb-none') as HTMLElement;
  const more = document.getElementById('hb-more') as HTMLButtonElement;
  const bannersWrap = document.getElementById('hb-banners');
  const banners = Array.from(document.querySelectorAll<HTMLElement>('.hb-banner'));
  const STEP = 24;
  let limit = STEP;
  let activeType = '';

  function matches(c: HTMLElement): boolean {
    const term = q.value.trim().toLowerCase();
    const tag = fTag.value.toLowerCase();
    const d = c.dataset;
    const okTerm = !term || (d.title ?? '').includes(term) || (d.question ?? '').includes(term) || (d.tags ?? '').includes(term);
    const okTyp = !activeType || d.type === activeType;
    const okTag = !tag || ('|' + (d.tags ?? '') + '|').includes('|' + tag + '|');
    return okTerm && okTyp && okTag;
  }

  function apply(resetLimit = false) {
    if (resetLimit) limit = STEP;
    const matched = cards.filter(matches);
    cards.forEach((c) => (c.hidden = true));
    matched.slice(0, limit).forEach((c) => (c.hidden = false));
    count.textContent = `${matched.length} heuristic${matched.length === 1 ? '' : 's'}`;
    none.hidden = matched.length > 0;
    more.hidden = matched.length <= limit;
  }

  banners.forEach((bn) => bn.addEventListener('click', () => {
    const t = bn.dataset.type ?? '';
    activeType = activeType === t ? '' : t;
    banners.forEach((x) => x.classList.toggle('active', x.dataset.type === activeType));
    bannersWrap?.classList.toggle('has-active', activeType !== '');
    apply(true);
  }));
  [q, fTag].forEach((el) => el.addEventListener('input', () => apply(true)));
  reset.addEventListener('click', () => {
    q.value = ''; fTag.value = ''; activeType = '';
    banners.forEach((x) => x.classList.remove('active'));
    bannersWrap?.classList.remove('has-active');
    apply(true);
  });
  more.addEventListener('click', () => { limit += STEP; apply(false); });

  // Landing from a legacy /heuristics_tag/<tag>/ URL.
  applyUrlFilter(fTag);

  // Activate a type filter from ?type=… (e.g. linked from the info page) and scroll to results.
  const initialType = new URLSearchParams(location.search).get('type') ?? '';
  if (initialType && banners.some((b) => b.dataset.type === initialType)) {
    activeType = initialType;
    banners.forEach((x) => x.classList.toggle('active', x.dataset.type === activeType));
    bannersWrap?.classList.add('has-active');
    requestAnimationFrame(() => document.getElementById('hb-banners')?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
  }
  apply(true);
</script>
