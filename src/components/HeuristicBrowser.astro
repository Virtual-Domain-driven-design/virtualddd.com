---
/** The heuristics browser: the three type banners, the filter bar and the grid.
 *
 * Used on `/heuristics/` with the banners, and on each type index without them
 * — there the type is already decided by the page. The filtering itself is
 * `CardFilter`; the banners are toggle buttons it understands.
 */
import HeuristicCard from './HeuristicCard.astro';
import CardFilter from './CardFilter.astro';
import type { CollectionEntry } from 'astro:content';
import { HEURISTIC_TYPES } from '../lib/heuristics';
import { tagOptions } from '../lib/collections';

interface Props {
  items: CollectionEntry<'heuristics'>[];
  /** Show the three type banners, which double as the type filter. */
  showBanners?: boolean;
}
const { items, showBanners = false } = Astro.props;

const tags = tagOptions(items);

// Counts come from the items in hand, so a filtered browser stays honest.
const banners = showBanners
  ? HEURISTIC_TYPES.map((t) => ({ ...t, count: items.filter((h) => h.data.type[0] === t.key).length }))
  : [];
---

<CardFilter
  noun={{ one: 'heuristic', many: 'heuristics' }}
  searchLabel="Search heuristics"
  searchPlaceholder="Search heuristics…"
  facets={[{ key: 'tags', param: 'tag', allLabel: 'All tags', label: 'Filter by tag', options: tags }]}
  pageSize={24}
  emptyMessage="No heuristics match your filters."
>
  {banners.length > 0 && (
    <div slot="controls" class="hb-banners tbanner-grid" role="group" aria-label="Filter by heuristic type">
      {banners.map((t) => (
        <button
          type="button" class="hb-banner tbanner scrim"
          data-test="type-filter" data-filter-toggle data-facet="type" data-value={t.key}
          aria-pressed="false"
          style={`background-image: url(${t.bg.src})`}
        >
          <span class="tbanner-body">
            <span class="tbanner-title">{t.title}</span>
            <span class="tbanner-text">{t.text}</span>
            <span class="tbanner-count">{t.count} heuristics</span>
          </span>
        </button>
      ))}
    </div>
  )}

  <div class="grid-cards hb-grid">
    {items.map((h) => <HeuristicCard heuristic={h} />)}
  </div>
</CardFilter>

<style>
  /* Banners come from patterns.css (.tbanner); this is the only local bit. */
  .hb-banners { margin-bottom: var(--space-8); }
  .hb-grid { --card-min: 16.25rem; }
</style>
