---
/** Previous / next navigation at the foot of a detail page.
 *
 * Was four near-identical copies; three were byte-identical.
 */
interface Item {
  href: string;
  title: string;
}
interface Props {
  prev?: Item;
  next?: Item;
  /** e.g. "story" → "← Previous story" / "Next story →". */
  noun: string;
}
const { prev, next, noun } = Astro.props;
---

{(prev || next) && (
  <nav class="prevnext" aria-label={`Previous and next ${noun}`}>
    {prev ? (
      <a class="pn" href={prev.href}>
        <span class="pn-label">← Previous {noun}</span>
        <span class="pn-title">{prev.title}</span>
      </a>
    ) : <span />}
    {next && (
      <a class="pn pn-next" href={next.href}>
        <span class="pn-label">Next {noun} →</span>
        <span class="pn-title">{next.title}</span>
      </a>
    )}
  </nav>
)}
