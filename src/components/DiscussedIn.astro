---
/** "Discussed in" — the sessions and stories that reference this heuristic. */
import Carousel from './Carousel.astro';
import TeaserCard from './TeaserCard.astro';
import type { Teaser } from '../lib/collections';

interface Props {
  items: Teaser[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <Carousel class="stack-top" eyebrow="Discussed in">
    {items.map((i) => (
      <TeaserCard
        href={i.href}
        title={i.title}
        img={i.img}
        badge={i.kind}
        iso={i.iso}
        dateFallback={i.fallback}
        accentMeta
      />
    ))}
  </Carousel>
)}
