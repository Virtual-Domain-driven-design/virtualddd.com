---
/** The white "index card" for a heuristic — used on the heuristics index and
 *  in the "discussed heuristics" carousel on sessions and stories. */
import type { CollectionEntry } from 'astro:content';
import { heuristicType, chipTone } from '../lib/heuristics';
import { packFacet } from '../lib/card-filter';

interface Props {
  heuristic: CollectionEntry<'heuristics'>;
  /** Hide the type badge where the surrounding section already states it. */
  showType?: boolean;
}
const { heuristic, showType = true } = Astro.props;
const d = heuristic.data;
const type = d.type[0] ?? '';
const info = heuristicType(type);
---

<a
  class="card card--heuristic"
  data-test="card"
  data-pagefind-ignore
  href={`/heuristics/${heuristic.id}/`}
  data-search={[d.title, d.question ?? '', ...d.tags].join(' ').toLowerCase()}
  data-type={packFacet([type])}
  data-tags={packFacet(d.tags)}
>
  {showType && type && <span class:list={['chip', 'chip--label', chipTone(type)]}>{info?.label ?? 'Heuristic'}</span>}
  {d.question && <p class="card-q">{d.question}</p>}
  <h3 class="card-title">{d.title}</h3>
  <span class="card-more">More info →</span>
</a>
