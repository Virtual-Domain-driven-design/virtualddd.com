---
/** The standard teaser card: image, date, title, subtitle.
 *
 * One implementation behind sessions, stories, open spaces and the
 * "discussed in" carousel. Styling lives in `patterns.css` (`.card`), so a
 * restyle is a one-file change rather than a sweep through every section.
 */
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  img?: ImageMetadata;
  /** Rendered width of the thumbnail; pick per layout (cards 480, wide 720). */
  imgWidth?: number;
  /** Opt in to a responsive `srcset` by describing the box the image fills,
   *  e.g. `(min-width: 900px) 52rem, 100vw`.
   *
   *  Deliberately not the default: a card in the shared grid is 260–400px
   *  wide at every breakpoint, so one 480px file already serves it, and every
   *  extra width is another derivative in every deploy. It earns its place
   *  where the box really changes size — a single-column list that is 832px on
   *  a desktop and 350px on a phone was sending the desktop file to both. */
  imgSizes?: string;
  /** Corner badge — session type, episode number, content kind. */
  badge?: string;
  /** Date line. `iso` drives the client-side local-time swap. */
  iso?: string;
  dateFallback?: string;
  /** Cyan uppercase date instead of the muted default. */
  accentMeta?: boolean;
  /** Appended to the date line, e.g. the session level. Worth showing when it
   *  is worth filtering on. */
  metaSuffix?: string;
  /** Line under the title — host, authors. */
  sub?: string;
  /** A second line under that one, kept separate so a card can credit the
   *  host and the people who spoke without running them into one sentence. */
  sub2?: string;
  excerpt?: string;
  /** Read-more affordance, e.g. "Read more →". */
  more?: string;
  /** `data-*` attributes the client-side filters read. */
  data?: Record<string, string>;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  href, title, img, imgWidth = 480, imgSizes, badge, iso, dateFallback, accentMeta = false,
  metaSuffix, sub, sub2, excerpt, more, data = {}, class: className, loading = 'lazy',
} = Astro.props;

const dataAttrs = Object.fromEntries(Object.entries(data).map(([k, v]) => [`data-${k}`, v]));
---

<a class:list={['card', className]} href={href} data-test="card" data-pagefind-ignore {...dataAttrs}>
  <div class="card-thumb">
    {img ? (
      imgSizes
        ? <Image src={img} alt="" width={imgWidth} widths={[Math.round(imgWidth / 2), imgWidth]} sizes={imgSizes} loading={loading} />
        : <Image src={img} alt="" width={imgWidth} loading={loading} />
    ) : <div class="card-thumb-ph"></div>}
    {badge && <span class="chip chip--label chip--primary card-badge">{badge}</span>}
  </div>
  <div class="card-body">
    {iso && (
      <p class:list={['card-meta', { 'card-meta--accent': accentMeta }]}>
        <time class="js-local" data-format="shortdate" datetime={iso} data-iso={iso}>{dateFallback}</time>
        {metaSuffix && <span class="card-meta-suffix">· {metaSuffix}</span>}
      </p>
    )}
    <h3 class="card-title" data-test="card-title">{title}</h3>
    {sub && <p class="card-sub">{sub}</p>}
    {sub2 && <p class="card-sub card-sub--guests" data-test="card-guests">{sub2}</p>}
    {excerpt && <p class="card-excerpt">{excerpt}</p>}
    {more && <span class="card-more">{more}</span>}
  </div>
</a>

<style>
  /* Only what is specific to this card: the clamped excerpt. Everything else
     comes from .card in patterns.css. */
  .card-excerpt {
    color: var(--color-text-muted);
    margin: var(--space-3) 0 0;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-body { display: flex; flex-direction: column; flex: 1; }
  /* Tight under the host line: the two are one credit, not two facts. */
  .card-sub--guests { margin-top: var(--space-1); color: var(--color-text); }
  .card-meta-suffix { font-weight: 500; opacity: 0.85; margin-left: 0.35em; }
</style>
