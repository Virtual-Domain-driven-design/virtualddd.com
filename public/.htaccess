# Uncomment each line the day its page ships.
# RewriteRule ^papers/?$ /reading-list/ [R=301,L]
# RewriteRule ^books/?$ /reading-list/ [R=301,L]
# /book-club/ stays a real page — no rule needed.
RewriteRule ^papers/?$ - [G,L]
RewriteRule ^books/?$ - [G,L]
</IfModule>
