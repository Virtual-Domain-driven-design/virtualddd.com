# --- 7. Remaining video URLs (441) — Gone --------------------------
# Imported third-party conference talks; not Virtual DDD content. The full
# inventory is kept in data/videos-inventory.csv so the section can return
# later at these exact URLs.
RewriteRule ^videos/ - [G,L]
RewriteRule ^videos_tag/ - [G,L]

# --- 8. Tag archives → the filtered index --------------------------
# There was once a page per tag. The indexes read ?tag= and pre-select
# it (src/lib/filter-url.ts); an unknown tag shows the full archive.
RewriteRule ^sessions_tag/([^/]+)/?$ /sessions/?tag=$1 [R=301,L,QSA]
RewriteRule ^facilitating-archdes_tag/([^/]+)/?$ /facilitating-archdes/?tag=$1 [R=301,L,QSA]
RewriteRule ^heuristics_tag/([^/]+)/?$ /heuristics/?tag=$1 [R=301,L,QSA]
# Open Space has five items and no filter UI, so its tags go to the index.
RewriteRule ^open-space_tag/([^/]+)/?$ /open-space/ [R=301,L]

# --- 9. Category, author and other generated archives — Gone -------
RewriteRule ^sessions_category/ - [G,L]
RewriteRule ^heuristics_category/ - [G,L]
RewriteRule ^dipl-team-member-category/ - [G,L]
RewriteRule ^category/ - [G,L]
RewriteRule ^tag/ - [G,L]
RewriteRule ^author/ - [G,L]

# --- 10. Pages that were never real — Gone -------------------------
RewriteRule ^demo-sessions/?$ - [G,L]
RewriteRule ^test-page-niet-weggooien/?$ - [G,L]
RewriteRule ^submit-community/?$ - [G,L]

# --- 11. Retired slugs (editorial merges and renames) --------------
# Content that moved after the URL inventory was taken: the old address
# keeps working. The hand-written ones first, then whatever the sync
# recorded when a slug changed or a page was retired in Notion.
RewriteRule ^heuristics/eventstorming-split-and-merge-above-7-people-on-process-and-design-level/?$ /heuristics/eventstorming-split-and-merge-above-7-people/ [R=301,L]

# --- 12. Pending: reading list and book club -----------------------
