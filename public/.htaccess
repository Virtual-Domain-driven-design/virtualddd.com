# Generated by scripts/build-redirects.mjs — do not edit by hand.
# The URL contract: 967 addresses, each served, redirected once, or Gone.
# Inputs are the inventories in data/. See docs/urls.md.

ErrorDocument 404 /404.html
ErrorDocument 410 /410/

<IfModule mod_mime.c>
AddType text/markdown .md
AddCharset UTF-8 .md
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# --- 0. One hostname -----------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.virtualddd\.com$ [NC]
RewriteRule ^(.*)$ https://virtualddd.com/$1 [R=301,L]

